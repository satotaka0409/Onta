<UserControl x:Class="Onta.View.WowFlutterMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="24" MinWidth="80"
             Background="Transparent">
  <Grid Margin="4,2">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <TextBlock x:Name="TitleText"
               FontWeight="SemiBold"
               VerticalAlignment="Center"
               Margin="0,0,8,0"
               Foreground="{StaticResource BrushText}"/>
    <Border Grid.Column="1"
            Background="{StaticResource BrushTrack}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            Height="16"
            VerticalAlignment="Center"
            CornerRadius="2"
            x:Name="Track">
      <Canvas x:Name="CanvasRoot" ClipToBounds="True" SizeChanged="OnTrackSizeChanged">
        <Rectangle x:Name="FillRect" Height="14" Canvas.Top="1"/>
        <Line x:Name="CenterLine" Y1="-2" Y2="18" Stroke="{StaticResource BrushTextMuted}" StrokeThickness="1.5"/>
        <Ellipse x:Name="Knob" Width="8" Height="20" Fill="{StaticResource BrushText}" Stroke="{StaticResource BrushBorder}" Canvas.Top="-2"/>
      </Canvas>
    </Border>
  </Grid>
</UserControl>
