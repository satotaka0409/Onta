<UserControl x:Class="Onta.View.ReceivePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:local="clr-namespace:Onta.View">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="120"/>
    </Grid.RowDefinitions>

    <TextBlock Text="受信" FontSize="18" FontWeight="Bold" Margin="4,0,0,8"/>

    <Grid Grid.Row="1" Margin="4,0,4,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="0.7*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="ファイル名" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="FileNameBox" Grid.Column="1" IsReadOnly="True" Margin="0,0,12,0"/>
      <TextBlock Grid.Column="2" Text="ファイルサイズ" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="FileSizeBox" Grid.Column="3" IsReadOnly="True" Margin="0,0,12,0"/>
      <TextBlock Grid.Column="4" Text="ブロック数" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="BlockCountBox" Grid.Column="5" IsReadOnly="True"/>
    </Grid>

    <Grid Grid.Row="2" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <local:WowFlutterMeter x:Name="WowLeft" ChannelLabel="L" Margin="0,0,6,0"/>
      <local:WowFlutterMeter x:Name="WowRight" Grid.Column="1" ChannelLabel="R" Margin="6,0,0,0"/>
    </Grid>

    <Border Grid.Row="3" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
            Background="{StaticResource BrushInput}" CornerRadius="3" Padding="4">
      <lvc:CartesianChart x:Name="ErrorChart"
                          Background="{StaticResource BrushInput}"
                          Series="{Binding Series}"
                          XAxes="{Binding XAxes}"
                          YAxes="{Binding YAxes}"
                          AnimationsSpeed="0"
                          TooltipPosition="Hidden"/>
    </Border>
  </Grid>
</UserControl>
