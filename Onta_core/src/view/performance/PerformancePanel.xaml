                                                ChannelLabel="L"
                                                Margin="0,0,2,0"/>
                          <core:WowFlutterMeter x:Name="WowRightMeter"
                                                Grid.Column="1"
                                                ChannelLabel="R"
                                                Margin="2,0,0,0"/>
                        </Grid>
                        <lvc:CartesianChart x:Name="WowFlutterChart"
                                            Grid.Row="1"
                                            Margin="0,4,0,0"
                                            Background="{StaticResource BrushInput}"
                                            AnimationsSpeed="0"
                                            TooltipPosition="Hidden"
                                            LegendPosition="Hidden"/>
                      </Grid>
                    </GroupBox>

                    <Border Padding="12,10"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Background="{StaticResource BrushPanel}">
                      <StackPanel>
                        <TextBlock Text="周波数カウンタ"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="L"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource BrushTextMuted}"/>
                          <TextBlock x:Name="LissFreqLeftText"
                                     Grid.Column="1"
                                     Text="---- Hz"
                                     FontSize="16"
                                     FontFamily="Consolas"
                                     HorizontalAlignment="Right"
                                     Foreground="{StaticResource BrushText}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="R"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource BrushTextMuted}"/>
                          <TextBlock x:Name="LissFreqRightText"
                                     Grid.Column="1"
                                     Text="---- Hz"
                                     FontSize="16"
                                     FontFamily="Consolas"
                                     HorizontalAlignment="Right"
                                     Foreground="{StaticResource BrushText}"/>
                        </Grid>
                        <TextBlock Text="歪み率"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="L"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource BrushTextMuted}"/>
                          <TextBlock x:Name="LissThdLeftText"
                                     Grid.Column="1"
                                     Text="--.-- %"
                                     FontSize="16"
                                     FontFamily="Consolas"
                                     HorizontalAlignment="Right"
                                     Foreground="{StaticResource BrushText}"/>
                        </Grid>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="R"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource BrushTextMuted}"/>
                          <TextBlock x:Name="LissThdRightText"
                                     Grid.Column="1"
                                     Text="--.-- %"
                                     FontSize="16"
                                     FontFamily="Consolas"
                                     HorizontalAlignment="Right"
                                     Foreground="{StaticResource BrushText}"/>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <!-- I-Q はタブの外（L/R を波形行に合わせて縦並び） -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"
                             MinHeight="200"/>
              <RowDefinition Height="*"
                             MinHeight="200"/>
            </Grid.RowDefinitions>
            <Border Height="{Binding ActualHeight, ElementName=WaveGraphTabHeaderRow}"
                    Margin="0,0,0,4"
                    Visibility="Hidden"/>
            <Border x:Name="IqLeftHost"
                    Grid.Row="1"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Background="{StaticResource BrushInput}"
                    Padding="6"
                    Width="260"
                    Margin="0,0,0,8"
                    VerticalAlignment="Stretch">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="IqLeftTitle"
                           Text="L I-Q"
                           Foreground="{StaticResource BrushTextMuted}"
                           Margin="0,0,0,2"/>
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <lvc:CartesianChart x:Name="IqLeftChart"
                                      Width="240"
                                      Height="240"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Background="{StaticResource BrushInput}"
                                      AnimationsSpeed="0"
                                      TooltipPosition="Hidden"
                                      LegendPosition="Hidden"/>
                  <StackPanel x:Name="IqLeftLegend"
                              Grid.Column="1"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"/>
                </Grid>
              </Grid>
            </Border>
            <Border x:Name="IqRightHost"
                    Grid.Row="2"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Background="{StaticResource BrushInput}"
                    Padding="6"
                    Width="260"
                    VerticalAlignment="Stretch">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="IqRightTitle"
                           Text="R I-Q"
                           Foreground="{StaticResource BrushTextMuted}"
                           Margin="0,0,0,2"/>
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <lvc:CartesianChart x:Name="IqRightChart"
                                      Width="240"
                                      Height="240"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Background="{StaticResource BrushInput}"
                                      AnimationsSpeed="0"
                                      TooltipPosition="Hidden"
                                      LegendPosition="Hidden"/>
                  <StackPanel x:Name="IqRightLegend"
                              Grid.Column="1"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"/>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
