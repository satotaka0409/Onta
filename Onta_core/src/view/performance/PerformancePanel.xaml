<UserControl x:Class="Onta.View.Performance.PerformancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Onta.View.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PanelBorder}"
                Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="送信"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <RadioButton x:Name="StereoRadio"
                                 GroupName="ChannelMode"
                                 Content="ステレオ"
                                 IsChecked="True"
                                 Margin="0,0,12,0"/>
                    <RadioButton x:Name="MonoRadio"
                                 GroupName="ChannelMode"
                                 Content="モノラル"/>
                </StackPanel>

                <Grid Grid.Row="2"
                      Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="無変調"
                              Margin="0,0,8,0">
                        <WrapPanel Margin="2">
                            <RadioButton x:Name="Tone315Radio"
                                    GroupName="SignalKind"
                                    Content="315Hz"
                                    IsChecked="True"
                                    Margin="0,0,10,4"/>
                            <RadioButton GroupName="SignalKind"
                                    Content="400Hz"
                                    Margin="0,0,10,4"/>
                            <RadioButton GroupName="SignalKind"
                                    Content="1KHz"
                                    Margin="0,0,10,4"/>
                            <RadioButton GroupName="SignalKind"
                                    Content="3KHz"
                                    Margin="0,0,10,4"/>
                            <RadioButton GroupName="SignalKind"
                                    Content="8KHz"
                                    Margin="0,0,10,4"/>
                            <RadioButton GroupName="SignalKind"
                                    Content="10KHz"
                                    Margin="0,0,10,4"/>
                            <RadioButton GroupName="SignalKind"
                                    Content="12.5KHz"
                                    Margin="0,0,10,4"/>
                            <RadioButton GroupName="SignalKind"
                                    Content="15KHz"
                                    Margin="0,0,10,4"/>
                            <RadioButton GroupName="SignalKind"
                                    Content="20KHz"
                                    Margin="0,0,10,4"/>
                            <RadioButton GroupName="SignalKind"
                                    Content="スイープ(20Hz-20KHz)"
                                    Margin="0,0,10,4"/>
                        </WrapPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="1"
                              Header="変調">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,6">
                                <TextBlock Text="サブキャリア"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ComboBox x:Name="SubcarrierCombo"
                                          Width="110"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="8-SC"/>
                                    <ComboBoxItem Content="16-SC"/>
                                    <ComboBoxItem Content="24-SC"/>
                                    <ComboBoxItem Content="32-SC"/>
                                    <ComboBoxItem Content="40-SC"/>
                                    <ComboBoxItem Content="48-SC"/>
                                    <ComboBoxItem Content="56-SC"/>
                                    <ComboBoxItem Content="64-SC"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal">
                                <TextBlock Text="変調"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ComboBox x:Name="ModulationCombo"
                                          Width="110"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="BPSK"/>
                                    <ComboBoxItem Content="QPSK"/>
                                    <ComboBoxItem Content="16QAM"/>
                                    <ComboBoxItem Content="64QAM"/>
                                    <ComboBoxItem Content="256QAM"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0"
                              Header="秒数"
                              MinWidth="180"
                              Margin="0,0,8,0">
                        <StackPanel>
                            <RadioButton x:Name="Sec10Radio"
                                         GroupName="Duration"
                                         Content="10秒"
                                         IsChecked="True"/>
                            <RadioButton GroupName="Duration"
                                         Content="30秒"/>
                            <RadioButton GroupName="Duration"
                                         Content="60秒"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="2"
                              Header="出力"
                              Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="ファイル"
                                       Margin="0,3,8,0"/>
                            <TextBox x:Name="InputFilePathTextBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     MinWidth="280"
                                     IsReadOnly="True"
                                     Margin="0,0,8,6"/>
                            <Button x:Name="BrowseFileButton"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Content="ファイル選択"
                                    Width="96"
                                    Margin="0,0,0,6"
                                    Click="OnBrowseFileClick"/>

                            <CheckBox x:Name="OutputWavCheckBox"
                                      Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      Content="WAV出力"
                                      IsChecked="True"
                                      Margin="0,0,0,6"/>

                            <StackPanel Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <CheckBox x:Name="OutputAudioCheckBox"
                                          Content="音声出力"
                                          Margin="0,0,8,0"/>
                                <ComboBox x:Name="AudioDeviceCombo"
                                          Width="230"
                                          Margin="0,0,8,0"/>
                                <TextBlock Text="音量"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <Slider x:Name="OutputVolumeSlider"
                                        Width="140"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="0.7"
                                        TickFrequency="0.1"
                                        IsSnapToTickEnabled="True"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <StackPanel Grid.Column="3"
                                Orientation="Vertical"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right">
                        <Button x:Name="StartButton"
                                Content="スタート"
                                Width="110"
                                Margin="0,0,0,6"
                                Click="OnStartClick"/>
                        <TextBlock x:Name="StatusText"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Right"
                                   Text="待機中"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="160"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="受信"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Border Grid.Row="1"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Background="{StaticResource BrushInput}"
                        Padding="8"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,6">
                            <TextBlock Text="ワウフラッター"
                                       Margin="0,2,10,0"/>
                            <TextBlock Text="L"
                                       Margin="0,2,4,0"/>
                            <TextBlock x:Name="WowLValueText"
                                       Width="62"
                                       Margin="0,2,8,0"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontFamily="Consolas"
                                       Text="+0.00%"/>
                            <TextBlock Text="R"
                                       Margin="0,2,4,0"/>
                            <TextBlock x:Name="WowRValueText"
                                       Width="62"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontFamily="Consolas"
                                       Text="+0.00%"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <core:WowFlutterMeter x:Name="WowLeftMeter"
                                                  Grid.Row="0"
                                                  Margin="0,0,0,4"/>
                            <core:WowFlutterMeter x:Name="WowRightMeter"
                                                  Grid.Row="1"
                                                  Margin="0,0,0,6"/>
                            <Canvas x:Name="WowTrendCanvas"
                                    Grid.Row="2"
                                    Background="Transparent"
                                    ClipToBounds="True"
                                    SizeChanged="OnWowTrendCanvasSizeChanged">
                                <Polyline x:Name="WowLTrendLine"
                                          Stroke="#FF6CBF6A"
                                          StrokeThickness="1.6"/>
                                <Polyline x:Name="WowRTrendLine"
                                          Stroke="#FFD4A05A"
                                          StrokeThickness="1.6"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Background="{StaticResource BrushInput}"
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="FFTグラフ（リアルタイム）"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,0,0,4"/>
                            <Canvas x:Name="FftCanvas"
                                    Grid.Row="1"
                                    ClipToBounds="True"
                                    SizeChanged="OnFftCanvasSizeChanged"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Background="{StaticResource BrushInput}"
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="I-Q グラフ（全サブキャリア）"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,0,0,4"/>
                            <Viewbox Grid.Row="1"
                                     Stretch="Uniform"
                                     StretchDirection="Both">
                                <Grid Width="320"
                                      Height="320">
                                    <Canvas x:Name="IqCanvas"
                                            Width="320"
                                            Height="320"
                                            Background="Transparent"/>
                                </Grid>
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
