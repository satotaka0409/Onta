                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Height="1"
                                VerticalAlignment="Top"
                                Background="#5C616C"
                                Opacity="0.7"/>
                        <Border Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Height="1"
