<UserControl x:Class="Onta.View.Performance.PerformancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:core="clr-namespace:Onta.View.Core">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 送信 -->
    <Border Grid.Row="0"
            Style="{StaticResource PanelBorder}"
            Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto" MinWidth="320"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    VerticalAlignment="Top"
                    Margin="0,0,8,0">
          <TextBlock Text="送信"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Margin="0,6,0,8"/>
          <GroupBox Header="チャンネル"
                    Margin="0,0,0,0">
            <StackPanel Margin="2">
              <RadioButton x:Name="MonoRadio"
                           Content="モノラル"
                           GroupName="PerfChannel"
                           IsChecked="True"
                           Margin="0,0,0,8"/>
              <RadioButton x:Name="StereoRadio"
                           Content="ステレオ"
                           GroupName="PerfChannel"/>
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <Grid Grid.Column="1"
              MinWidth="320"
              VerticalAlignment="Top">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <RadioButton x:Name="ReferenceSignalRadio"
                         Content="基準信号"
                         GroupName="PerfSignalMode"
                         IsChecked="True"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Checked="OnSignalModeChanged"/>
            <RadioButton x:Name="ModulatedSignalRadio"
                         Content="変調"
                         GroupName="PerfSignalMode"
                         VerticalAlignment="Center"
                         Checked="OnSignalModeChanged"/>
          </StackPanel>
          <Border Grid.Row="1"
                  BorderBrush="{StaticResource BrushBorder}"
                  BorderThickness="1"
                  CornerRadius="3"
                  Background="{StaticResource BrushPanelAlt}"
                  Padding="4">
            <Grid>
              <Border x:Name="ReferenceSignalHost">
                <Grid Margin="4,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <UniformGrid Columns="2"
                               Margin="4,4,8,4"
                               VerticalAlignment="Top">
                    <RadioButton x:Name="Tone315Radio"
                                 GroupName="PerfTone"
                                 Content="315Hz"
                                 Tag="315"
                                 IsChecked="True"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,12,4"
                                 Checked="OnToneSelectionChanged"/>
                    <RadioButton GroupName="PerfTone" Content="400Hz" Tag="400"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Margin="0,0,12,4"
                                 Checked="OnToneSelectionChanged"/>
                    <RadioButton GroupName="PerfTone" Content="1KHz" Tag="1000"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Margin="0,0,12,4"
                                 Checked="OnToneSelectionChanged"/>
                    <RadioButton GroupName="PerfTone" Content="3KHz" Tag="3000"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Margin="0,0,12,4"
                                 Checked="OnToneSelectionChanged"/>
                    <RadioButton GroupName="PerfTone" Content="8KHz" Tag="8000"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Margin="0,0,12,4"
                                 Checked="OnToneSelectionChanged"/>
                    <RadioButton GroupName="PerfTone" Content="10KHz" Tag="10000"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Margin="0,0,12,4"
                                 Checked="OnToneSelectionChanged"/>
                    <RadioButton GroupName="PerfTone" Content="12.5KHz" Tag="12500"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Margin="0,0,12,4"
                                 Checked="OnToneSelectionChanged"/>
                    <RadioButton GroupName="PerfTone" Content="15KHz" Tag="15000"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Margin="0,0,12,4"
                                 Checked="OnToneSelectionChanged"/>
                    <RadioButton GroupName="PerfTone" Content="20KHz" Tag="20000"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Margin="0,0,12,4"
                                 Checked="OnToneSelectionChanged"/>
                    <RadioButton x:Name="SweepRadio"
                                 GroupName="PerfTone"
                                 Content="スイープ(20Hz～20KHz)"
                                 Tag="sweep"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,12,4"
                                 Checked="OnToneSelectionChanged"/>
                  </UniformGrid>
                  <StackPanel Grid.Column="1"
                              Margin="4,4,6,4"
                              VerticalAlignment="Top"
                              MinWidth="28">
                    <Slider x:Name="SignalLevelSlider"
                            Orientation="Vertical"
                            Minimum="0.10"
                            Maximum="1.00"
                            Value="0.70"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="False"
                            IsMoveToPointEnabled="True"
                            Height="88"
                            HorizontalAlignment="Center"
                            ValueChanged="OnSignalLevelChanged"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border x:Name="ModulatedSignalHost"
                      Opacity="0"
                      IsHitTestVisible="False">
                <Grid Margin="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <GroupBox Header="サブキャリア" Margin="4">
                    <UniformGrid x:Name="SubcarrierPanel"
                                 Columns="3"
                                 Margin="3">
                      <RadioButton Content="8-SC" Tag="8" GroupName="PerfSubcarrier" IsChecked="True" Margin="0,0,4,2"/>
                      <RadioButton Content="16-SC" Tag="16" GroupName="PerfSubcarrier" Margin="0,0,4,2"/>
                      <RadioButton Content="24-SC" Tag="24" GroupName="PerfSubcarrier" Margin="0,0,4,2"/>
                      <RadioButton Content="32-SC" Tag="32" GroupName="PerfSubcarrier" Margin="0,0,4,2"/>
                      <RadioButton Content="40-SC" Tag="40" GroupName="PerfSubcarrier" Margin="0,0,4,2"/>
                      <RadioButton Content="48-SC" Tag="48" GroupName="PerfSubcarrier" Margin="0,0,4,2"/>
                      <RadioButton Content="56-SC" Tag="56" GroupName="PerfSubcarrier" Margin="0,0,4,2"/>
                      <RadioButton Content="64-SC" Tag="64" GroupName="PerfSubcarrier" Margin="0,0,4,2"/>
                    </UniformGrid>
                  </GroupBox>
                  <GroupBox Grid.Column="1" Header="変調" Margin="4">
                    <UniformGrid x:Name="ModulationPanel"
                                 Columns="2"
                                 Margin="2">
                      <RadioButton Content="BPSK" Tag="Bpsk" GroupName="PerfModulation" IsChecked="True" Margin="0,0,6,4"/>
                      <RadioButton Content="QPSK" Tag="Qpsk" GroupName="PerfModulation" Margin="0,0,0,4"/>
                      <RadioButton Content="16QAM" Tag="Qam16" GroupName="PerfModulation" Margin="0,0,6,4"/>
                      <RadioButton Content="64QAM" Tag="Qam64" GroupName="PerfModulation" Margin="0,0,0,4"/>
                      <RadioButton Content="256QAM" Tag="Qam256" GroupName="PerfModulation" Margin="0,0,6,0"/>
                    </UniformGrid>
                  </GroupBox>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Column="3"
              VerticalAlignment="Stretch">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <GroupBox Header="秒数" VerticalAlignment="Stretch">
            <StackPanel Margin="2" HorizontalAlignment="Left">
              <RadioButton x:Name="Sec30Radio" GroupName="PerfDuration" Content="30秒" Tag="30" IsChecked="True"/>
              <RadioButton GroupName="PerfDuration" Content="60秒" Tag="60"/>
              <RadioButton GroupName="PerfDuration" Content="120秒" Tag="120"/>
            </StackPanel>
          </GroupBox>

          <GroupBox Grid.Column="2" Header="出力">
              <Grid Margin="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <RadioButton x:Name="WriteWavRadio"
                               Content="WAV出力"
                               GroupName="PerfOutputMode"
                               IsChecked="True"
                               VerticalAlignment="Center"
                               Checked="OnOutputModeChanged"/>
                  <RadioButton x:Name="PlayAudioRadio"
                               Content="音声出力"
                               GroupName="PerfOutputMode"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Checked="OnOutputModeChanged"/>
                </StackPanel>
                <Grid Grid.Row="1">
                  <StackPanel x:Name="WavOutputPanel"
                              Orientation="Horizontal"
                              VerticalAlignment="Center">
                    <TextBlock Text="出力ファイル"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox x:Name="WavPathTextBox"
                             MinWidth="350"
                             IsReadOnly="True"
                             VerticalAlignment="Center"/>
                    <Button x:Name="BrowseWavButton"
                            Content="..."
                            Width="36"
                            Margin="8,0,0,0"
                            Click="OnBrowseWavClick"/>
                  </StackPanel>
                  <StackPanel x:Name="AudioOutputPanel"
                              Orientation="Horizontal"
                              VerticalAlignment="Center"
                              Visibility="Collapsed">
                    <TextBlock Text="出力デバイス"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="OutputDeviceCombo"
                              Width="230"
                              Foreground="#FF1E2024"
                              VerticalAlignment="Center">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}" Foreground="#FF1E2024"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                      <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                          <Setter Property="Foreground" Value="#FF1E2024"/>
                          <Setter Property="Background" Value="White"/>
                        </Style>
                      </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBlock Text="音量"
                               VerticalAlignment="Center"
                               Margin="12,0,6,0"/>
                    <Slider x:Name="OutputVolumeSlider"
                            Width="120"
                            Minimum="0"
                            Maximum="100"
                            Value="80"
                            TickFrequency="5"
                            IsSnapToTickEnabled="False"
                            VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </GroupBox>

            <Grid Grid.Column="3"
                  VerticalAlignment="Stretch"
                  Margin="16,0,4,4">
              <StackPanel VerticalAlignment="Bottom"
                          HorizontalAlignment="Right">
                <Button x:Name="TxStartButton"
                        Content="スタート"
                        Width="110"
                        Height="34"
                        Click="OnTxStartClick"/>
                <Button x:Name="TxStopButton"
                        Content="ストップ"
                        Width="110"
                        Height="34"
                        Margin="0,8,0,0"
                        IsEnabled="False"
                        Click="OnTxStopClick"/>
              </StackPanel>
              <TextBlock x:Name="TxStatusText"
                         VerticalAlignment="Top"
                         HorizontalAlignment="Right"
                         Foreground="{StaticResource BrushTextMuted}"
                         Text=""/>
            </Grid>
        </Grid>
      </Grid>
    </Border>

    <!-- 受信 -->
    <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="200"/>
          <RowDefinition Height="*" MinHeight="200"/>
        </Grid.RowDefinitions>

        <TextBlock Text="受信"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="4,0,0,8"/>

        <!-- ワウ | 入力 | スタート/ストップ（出力フォルダーなし） -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <GroupBox Grid.Column="0"
                    Header="ワウフラッター"
                    Style="{StaticResource GroupBoxCompact}"
                    Width="420"
                    Margin="4"
                    VerticalAlignment="Stretch">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <core:WowFlutterMeter x:Name="WowLeftMeter"
                                      ChannelLabel="L"
                                      Margin="0,0,2,0"/>
                <core:WowFlutterMeter x:Name="WowRightMeter"
                                      Grid.Column="1"
                                      ChannelLabel="R"
                                      Margin="2,0,0,0"/>
              </Grid>
              <lvc:CartesianChart x:Name="WowFlutterChart"
                                  Grid.Row="1"
                                  Margin="0,4,0,0"
                                  Background="{StaticResource BrushInput}"
                                  AnimationsSpeed="0"
                                  TooltipPosition="Hidden"
                                  LegendPosition="Hidden"/>
            </Grid>
          </GroupBox>

          <GroupBox Grid.Column="1"
                    Header="入力"
                    Margin="4"
                    VerticalAlignment="Stretch">
            <Grid Margin="4,2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton x:Name="RxWavInputRadio"
                             Content="WAV入力"
                             GroupName="PerfReceiveInputMode"
                             IsChecked="True"
                             VerticalAlignment="Center"
                             Checked="OnRxInputModeChanged"/>
                <RadioButton x:Name="RxAudioInputRadio"
                             Content="音声入力"
                             GroupName="PerfReceiveInputMode"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"
                             Checked="OnRxInputModeChanged"/>
              </StackPanel>
              <Grid Grid.Row="1">
                <Grid x:Name="RxWavInputPanel">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="入力ファイル"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                  <TextBox x:Name="RxWavPathBox"
                           Grid.Column="1"
                           IsReadOnly="True"
                           VerticalAlignment="Center"/>
                  <Button Grid.Column="2"
                          x:Name="RxBrowseWavButton"
                          Content="..."
                          Width="36"
                          Margin="8,0,0,0"
                          Click="OnBrowseRxWavClick"/>
                </Grid>
                <Grid x:Name="RxAudioInputPanel" Visibility="Collapsed">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="入力デバイス"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center">
                    <ComboBox x:Name="InputDeviceCombo"
                              Width="220"
                              Foreground="#FF1E2024"
                              VerticalAlignment="Center">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}" Foreground="#FF1E2024"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                      <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                          <Setter Property="Foreground" Value="#FF1E2024"/>
                          <Setter Property="Background" Value="White"/>
                        </Style>
                      </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBlock Text="音量"
                               VerticalAlignment="Center"
                               Margin="12,0,6,0"/>
                    <Slider x:Name="InputGainSlider"
                            Width="120"
                            Minimum="0"
                            Maximum="100"
                            Value="80"
                            TickFrequency="5"
                            IsSnapToTickEnabled="False"
                            VerticalAlignment="Center"
                            ValueChanged="OnRxInputVolumeChanged"/>
                    <TextBlock x:Name="RxInputVolumeValueText"
                               Text="80%"
                               Width="36"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               TextAlignment="Right"/>
                  </StackPanel>
                </Grid>
              </Grid>
              <TextBlock x:Name="RxStatusText"
                         Grid.Row="2"
                         Margin="0,8,0,0"
                         VerticalAlignment="Bottom"
                         Foreground="{StaticResource BrushTextMuted}"
                         Text=""/>
            </Grid>
          </GroupBox>

          <StackPanel Grid.Column="2"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom"
                      Margin="16,0,4,4">
            <Button x:Name="RxStartButton"
                    Content="スタート"
                    Width="110"
                    Height="34"
                    Click="OnRxStartClick"/>
            <Button x:Name="RxStopButton"
                    Content="ストップ"
                    Width="110"
                    Height="34"
                    Margin="0,8,0,0"
                    IsEnabled="False"
                    Click="OnRxStopClick"/>
          </StackPanel>
        </Grid>

        <!-- L/R 共通: FFT ⇔ オシロスコープ -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,4">
          <RadioButton x:Name="FftTabRadio"
                       Content="FFT"
                       GroupName="PerfWaveGraphTab"
                       IsChecked="True"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Checked="OnWaveGraphTabChanged"/>
          <RadioButton x:Name="ScopeTabRadio"
                       Content="オシロスコープ"
                       GroupName="PerfWaveGraphTab"
                       VerticalAlignment="Center"
                       Checked="OnWaveGraphTabChanged"/>
          <CheckBox x:Name="ScopeLrSyncCheck"
                    Content="L/R 同期"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Checked="OnScopeLrSyncChanged"
                    Unchecked="OnScopeLrSyncChanged"/>
        </StackPanel>

        <!-- L -->
        <Grid x:Name="LeftWaveRow"
              Grid.Row="3"
              Margin="0,0,0,8"
              SizeChanged="OnWaveRowSizeChanged">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                  CornerRadius="3" Background="{StaticResource BrushInput}" Padding="6"
                  ClipToBounds="False"
                  Grid.IsSharedSizeScope="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="LeftWaveTitle"
                         Text="L FFT"
                         Foreground="{StaticResource BrushTextMuted}"
                         Margin="0,0,0,2"/>
              <Grid Grid.Row="1" ClipToBounds="False">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="PerfFftYLeft"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                  <Grid x:Name="FftLeftDbLabels" Margin="0,0,4,0" ClipToBounds="False">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Magnitude (dB)"
                             FontSize="9"
                             Foreground="{StaticResource BrushTextMuted}"
                             VerticalAlignment="Center"
                             Margin="0,0,4,0">
                    <TextBlock.LayoutTransform>
                      <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                  </TextBlock>
                  <Grid x:Name="FftLeftDbTickLabels"
                        Grid.Column="1"
                        Margin="0,0,0,0"
                        ClipToBounds="False">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="0" Grid.Row="0" Height="14" Margin="0,-7,0,0"
                               VerticalAlignment="Top" TextAlignment="Right"
                               FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock Text="-20" Grid.Row="1" Height="14" Margin="0,-7,0,0"
                               VerticalAlignment="Top" TextAlignment="Right"
                               FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock Text="-40" Grid.Row="2" Height="14" Margin="0,-7,0,0"
                               VerticalAlignment="Top" TextAlignment="Right"
                               FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock Text="-60" Grid.Row="3" Height="14" Margin="0,-7,0,0"
                               VerticalAlignment="Top" TextAlignment="Right"
                               FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock Text="-80" Grid.Row="4" Height="14" Margin="0,-7,0,0"
                               VerticalAlignment="Top" TextAlignment="Right"
                               FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock Text="-100" Grid.Row="4" Height="14" Margin="0,0,0,-7"
                               VerticalAlignment="Bottom" TextAlignment="Right"
                               FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                  </Grid>
                </Grid>
                  <Grid x:Name="ScopeLeftAmpHost"
                        Visibility="Collapsed"
                        Margin="0,0,4,0"
                        MinWidth="28">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ScopeLeftAmpValue"
                               Text="±1.0"
                               FontSize="9"
                               TextAlignment="Center"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,0,0,4"/>
                    <Slider x:Name="ScopeLeftAmpSlider"
                            Grid.Row="1"
                            Orientation="Vertical"
                            Minimum="0"
                            Maximum="3"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True"
                            Value="3"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Center"
                            Width="18"
                            ValueChanged="OnScopeRangeChanged"/>
                  </Grid>
                </Grid>
                <Grid Grid.Column="1" ClipToBounds="False">
                  <Border x:Name="FftLeftHost" ClipToBounds="False">
                    <lvc:CartesianChart x:Name="FftLeftChart"
                                        Background="{StaticResource BrushInput}"
                                        ClipToBounds="False"
                                        AnimationsSpeed="0"
                                        TooltipPosition="Hidden"
                                        LegendPosition="Hidden"/>
                  </Border>
                  <Border x:Name="ScopeLeftHost"
                          Opacity="0"
                          IsHitTestVisible="False"
                          ClipToBounds="False">
                    <lvc:CartesianChart x:Name="ScopeLeftChart"
                                        Background="{StaticResource BrushInput}"
                                        ClipToBounds="False"
                                        AnimationsSpeed="0"
                                        TooltipPosition="Hidden"
                                        LegendPosition="Hidden"/>
                  </Border>
                </Grid>
              </Grid>
              <Grid Grid.Row="2" Margin="0,2,0,0" ClipToBounds="False">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="PerfFftYLeft"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Canvas x:Name="FftLeftFreqLabels"
                        Grid.Column="1"
                        Height="16"
                        ClipToBounds="False"/>
                <Grid x:Name="ScopeLeftTimeHost"
                      Grid.Column="1"
                      Visibility="Collapsed"
                      Height="22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Slider x:Name="ScopeLeftTimeSlider"
                          Minimum="0"
                          Maximum="6"
                          TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          IsMoveToPointEnabled="True"
                          Value="4"
                          VerticalAlignment="Center"
                          ValueChanged="OnScopeRangeChanged"/>
                  <TextBlock x:Name="ScopeLeftTimeValue"
                             Grid.Column="1"
                             Text="20 ms"
                             Width="44"
                             FontSize="9"
                             Margin="6,0,0,0"
                             VerticalAlignment="Center"
                             TextAlignment="Right"
                             Foreground="{StaticResource BrushTextMuted}"/>
                </Grid>
              </Grid>
            </Grid>
          </Border>
          <Border x:Name="IqLeftHost"
                  Grid.Column="2"
                  BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                  CornerRadius="3" Background="{StaticResource BrushInput}" Padding="6"
                  Width="260">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="IqLeftTitle"
                         Text="L I-Q"
                         Foreground="{StaticResource BrushTextMuted}"
                         Margin="0,0,0,2"/>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <lvc:CartesianChart x:Name="IqLeftChart"
                                    Width="240" Height="240"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource BrushInput}"
                                    AnimationsSpeed="0"
                                    TooltipPosition="Hidden"
                                    LegendPosition="Hidden"/>
                <StackPanel x:Name="IqLeftLegend"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <!-- R -->
        <Grid x:Name="RightWaveRow"
              Grid.Row="4"
              Margin="0,0,0,0"
              SizeChanged="OnWaveRowSizeChanged">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                  CornerRadius="3" Background="{StaticResource BrushInput}" Padding="6"
                  ClipToBounds="False"
                  Grid.IsSharedSizeScope="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="RightWaveTitle"
                         Text="R FFT"
                         Foreground="{StaticResource BrushTextMuted}"
                         Margin="0,0,0,2"/>
              <Grid Grid.Row="1" ClipToBounds="False">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="PerfFftYRight"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                  <Grid x:Name="FftRightDbLabels" Margin="0,0,4,0" ClipToBounds="False">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Magnitude (dB)"
                             FontSize="9"
                             Foreground="{StaticResource BrushTextMuted}"
                             VerticalAlignment="Center"
                             Margin="0,0,4,0">
                    <TextBlock.LayoutTransform>
                      <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                  </TextBlock>
                  <Grid x:Name="FftRightDbTickLabels"
                        Grid.Column="1"
                        Margin="0,0,0,0"
                        ClipToBounds="False">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="0" Grid.Row="0" Height="14" Margin="0,-7,0,0"
                               VerticalAlignment="Top" TextAlignment="Right"
                               FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock Text="-20" Grid.Row="1" Height="14" Margin="0,-7,0,0"
                               VerticalAlignment="Top" TextAlignment="Right"
                               FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock Text="-40" Grid.Row="2" Height="14" Margin="0,-7,0,0"
                               VerticalAlignment="Top" TextAlignment="Right"
                               FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock Text="-60" Grid.Row="3" Height="14" Margin="0,-7,0,0"
                               VerticalAlignment="Top" TextAlignment="Right"
                               FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock Text="-80" Grid.Row="4" Height="14" Margin="0,-7,0,0"
                               VerticalAlignment="Top" TextAlignment="Right"
                               FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock Text="-100" Grid.Row="4" Height="14" Margin="0,0,0,-7"
                               VerticalAlignment="Bottom" TextAlignment="Right"
                               FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                  </Grid>
                </Grid>
                  <Grid x:Name="ScopeRightAmpHost"
                        Visibility="Collapsed"
                        Margin="0,0,4,0"
                        MinWidth="28">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ScopeRightAmpValue"
                               Text="±1.0"
                               FontSize="9"
                               TextAlignment="Center"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,0,0,4"/>
                    <Slider x:Name="ScopeRightAmpSlider"
                            Grid.Row="1"
                            Orientation="Vertical"
                            Minimum="0"
                            Maximum="3"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True"
                            Value="3"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Center"
                            Width="18"
                            ValueChanged="OnScopeRangeChanged"/>
                  </Grid>
                </Grid>
                <Grid Grid.Column="1" ClipToBounds="False">
                  <Border x:Name="FftRightHost" ClipToBounds="False">
                    <lvc:CartesianChart x:Name="FftRightChart"
                                        Background="{StaticResource BrushInput}"
                                        ClipToBounds="False"
                                        AnimationsSpeed="0"
                                        TooltipPosition="Hidden"
                                        LegendPosition="Hidden"/>
                  </Border>
                  <Border x:Name="ScopeRightHost"
                          Opacity="0"
                          IsHitTestVisible="False"
                          ClipToBounds="False">
                    <lvc:CartesianChart x:Name="ScopeRightChart"
                                        Background="{StaticResource BrushInput}"
                                        ClipToBounds="False"
                                        AnimationsSpeed="0"
                                        TooltipPosition="Hidden"
                                        LegendPosition="Hidden"/>
                  </Border>
                </Grid>
              </Grid>
              <Grid Grid.Row="2" Margin="0,2,0,0" ClipToBounds="False">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="PerfFftYRight"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Canvas x:Name="FftRightFreqLabels"
                        Grid.Column="1"
                        Height="16"
                        ClipToBounds="False"/>
                <Grid x:Name="ScopeRightTimeHost"
                      Grid.Column="1"
                      Visibility="Collapsed"
                      Height="22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Slider x:Name="ScopeRightTimeSlider"
                          Minimum="0"
                          Maximum="6"
                          TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          IsMoveToPointEnabled="True"
                          Value="4"
                          VerticalAlignment="Center"
                          ValueChanged="OnScopeRangeChanged"/>
                  <TextBlock x:Name="ScopeRightTimeValue"
                             Grid.Column="1"
                             Text="20 ms"
                             Width="44"
                             FontSize="9"
                             Margin="6,0,0,0"
                             VerticalAlignment="Center"
                             TextAlignment="Right"
                             Foreground="{StaticResource BrushTextMuted}"/>
                </Grid>
              </Grid>
            </Grid>
          </Border>
          <Border x:Name="IqRightHost"
                  Grid.Column="2"
                  BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                  CornerRadius="3" Background="{StaticResource BrushInput}" Padding="6"
                  Width="260">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="IqRightTitle"
                         Text="R I-Q"
                         Foreground="{StaticResource BrushTextMuted}"
                         Margin="0,0,0,2"/>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <lvc:CartesianChart x:Name="IqRightChart"
                                    Width="240" Height="240"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource BrushInput}"
                                    AnimationsSpeed="0"
                                    TooltipPosition="Hidden"
                                    LegendPosition="Hidden"/>
                <StackPanel x:Name="IqRightLegend"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
