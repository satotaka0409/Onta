<UserControl x:Class="Onta.View.Core.SendPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:Onta.View.Language"
             xmlns:ontacore="clr-namespace:Onta.Core">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Text="{x:Static lang:CoreViewText.Send}"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Margin="0,6,0,8"/>

      <!-- 送信中はここ全体を Disable（ストップだけ右側に残す） -->
      <Grid Margin="30,0,0,0"
            x:Name="SettingsHost">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="140"/>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="{x:Static lang:CoreViewText.Channel}"
                  Margin="4">
          <StackPanel Margin="2">
            <RadioButton x:Name="MonoRadio"
                         Content="{x:Static lang:CoreViewText.Mono}"
                         GroupName="Channel"
                         IsChecked="True"
                         Margin="0,0,0,8"/>
            <RadioButton x:Name="StereoRadio"
                         Content="{x:Static lang:CoreViewText.Stereo}"
                         GroupName="Channel"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="1"
                  Header="{x:Static lang:CoreViewText.Subcarrier}"
                  Margin="4">
          <UniformGrid Columns="2"
                       Margin="3">
            <RadioButton Content="16-SC"
                         Tag="16"
                         GroupName="Subcarrier"
                         IsChecked="True"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
            <RadioButton Content="24-SC"
                         Tag="24"
                         GroupName="Subcarrier"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
            <RadioButton Content="32-SC"
                         Tag="32"
                         GroupName="Subcarrier"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
            <RadioButton Content="40-SC"
                         Tag="40"
                         GroupName="Subcarrier"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
            <RadioButton Content="48-SC"
                         Tag="48"
                         GroupName="Subcarrier"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
            <RadioButton Content="56-SC"
                         Tag="56"
                         GroupName="Subcarrier"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
            <RadioButton Content="64-SC"
                         Tag="64"
                         GroupName="Subcarrier"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
            <RadioButton Content="72-SC"
                         Tag="72"
                         GroupName="Subcarrier"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
          </UniformGrid>
        </GroupBox>

        <GroupBox Grid.Column="2"
                  Header="{x:Static lang:CoreViewText.Modulation}"
                  Margin="4">
          <UniformGrid Columns="2"
                       Margin="3">
            <RadioButton Content="BPSK"
                         Tag="Bpsk"
                         GroupName="Modulation"
                         IsChecked="True"
                         Checked="OnSettingsChanged"/>
            <RadioButton Content="QPSK"
                         Tag="Qpsk"
                         GroupName="Modulation"
                         Checked="OnSettingsChanged"/>
            <RadioButton Content="8PSK"
                         Tag="Psk8"
                         GroupName="Modulation"
                         Checked="OnSettingsChanged"/>
            <RadioButton Content="16QAM"
                         Tag="Qam16"
                         GroupName="Modulation"
                         Checked="OnSettingsChanged"/>
            <RadioButton Content="64QAM"
                         Tag="Qam64"
                         GroupName="Modulation"
                         Checked="OnSettingsChanged"/>
          </UniformGrid>
        </GroupBox>

        <GroupBox Grid.Column="3"
                  Header="Interleave"
                  Margin="4">
          <StackPanel Margin="2">
            <RadioButton Content="x1"
                         Tag="1"
                         GroupName="Interleave"
                         IsChecked="True"
                         Checked="OnSettingsChanged"/>
            <RadioButton Content="x2"
                         Tag="2"
                         GroupName="Interleave"
                         Checked="OnSettingsChanged"
                         Margin="0,0,0,2"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="4"
                  Header="{x:Static lang:CoreViewText.Output}"
                  Margin="4">
          <Grid Margin="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Content="{x:Static lang:CoreViewText.SendFile}"
                      Width="90"
                      VerticalAlignment="Center"
                      Click="OnBrowseInput"/>
              <Button Grid.Column="1"
                      Content="{x:Static lang:CoreViewText.ClearSelection}"
                      Width="60"
                      Margin="6,0,0,0"
                      VerticalAlignment="Center"
                      Click="OnClearInput"/>
              <TextBox x:Name="InputPathBox"
                       Grid.Column="2"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       IsReadOnly="True"
                       AllowDrop="True"
                       PreviewDragOver="OnInputPathDragOver"
                       Drop="OnInputPathDrop"/>
            </Grid>
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,8,0,0">
              <RadioButton x:Name="WriteWavRadio"
                           Content="{x:Static lang:CoreViewText.WavOutput}"
                           GroupName="OutputMode"
                           IsChecked="True"
                           VerticalAlignment="Center"
                           Checked="OnSettingsChanged"/>
              <RadioButton x:Name="PlayAudioRadio"
                           Content="{x:Static lang:CoreViewText.AudioOutput}"
                           GroupName="OutputMode"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Checked="OnSettingsChanged"/>
              <ComboBox x:Name="WavSampleRateCombo"
                        Width="118"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        SelectionChanged="OnWavSampleRateChanged">
                <ComboBoxItem Tag="{x:Static ontacore:OfdmConfig.ModemSampleRate}"
                              IsSelected="True">
                  <TextBlock Text="{Binding Source={x:Static ontacore:OfdmConfig.ModemSampleRate}, StringFormat={}{0} Hz}"
                             Foreground="{StaticResource BrushComboForeground}"/>
                </ComboBoxItem>
                <ComboBoxItem Tag="48000">
                  <TextBlock Text="48000 Hz"
                             Foreground="{StaticResource BrushComboForeground}"/>
                </ComboBoxItem>
                <ComboBoxItem Tag="96000">
                  <TextBlock Text="96000 Hz"
                             Foreground="{StaticResource BrushComboForeground}"/>
                </ComboBoxItem>
              </ComboBox>
            </StackPanel>
            <Grid Grid.Row="2"
                  Margin="0,8,0,0">
              <StackPanel x:Name="WavOutputPanel"
                          Orientation="Horizontal"
                          VerticalAlignment="Center">
                <TextBlock Text="{x:Static lang:CoreViewText.OutputFile}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="WavPathBox"
                         Width="440"
                         IsReadOnly="True"
                         VerticalAlignment="Center"/>
                <Button Content="..."
                        Width="36"
                        Margin="8,0,0,0"
                        Click="OnBrowseWav"/>
              </StackPanel>
              <StackPanel x:Name="AudioOutputPanel"
                          Orientation="Horizontal"
                          VerticalAlignment="Center"
                          Visibility="Collapsed">
                <TextBlock Text="{x:Static lang:CoreViewText.OutputDevice}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="AudioDeviceComboBox"
                          Width="160"
                          SelectedValuePath="DeviceNumber"
                          SelectionChanged="OnAudioDeviceSelectionChanged">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}"
                                 Foreground="{StaticResource BrushComboForeground}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{x:Static lang:CoreViewText.Volume}"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0"/>
                <Slider x:Name="AudioVolumeSlider"
                        Width="120"
                        Minimum="0"
                        Maximum="100"
                        Value="80"
                        TickFrequency="5"
                        IsSnapToTickEnabled="False"
                        VerticalAlignment="Center"
                        ValueChanged="OnAudioVolumeChanged"/>
                <TextBlock x:Name="AudioVolumeValueText"
                           Text="80%"
                           Width="36"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           TextAlignment="Right"/>
              </StackPanel>
            </Grid>
          </Grid>
        </GroupBox>
      </Grid>

      <StackPanel Grid.Column="1"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="16,0,4,4">
        <Button x:Name="StartButton"
                Content="{x:Static lang:CoreViewText.Start}"
                Width="110"
                Height="34"
                Click="OnStartClick"/>
        <Button x:Name="StopButton"
                Content="{x:Static lang:CoreViewText.Stop}"
                Width="110"
                Height="34"
                Margin="0,8,0,0"
                IsEnabled="False"
                Click="OnStopClick"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

