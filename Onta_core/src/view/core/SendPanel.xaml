<UserControl x:Class="Onta.View.Core.SendPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Text="送信"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Margin="0,6,0,8"/>

      <!-- 送信中はここ全体を Disable（ストップだけ右側に残す） -->
      <Grid Margin="30,0,0,0"
            x:Name="SettingsHost">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="140"/>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="チャンネル"
                  Margin="4">
          <StackPanel Margin="2">
            <RadioButton x:Name="MonoRadio"
                         Content="モノラル"
                         GroupName="Channel"
                         IsChecked="True"
                         Margin="0,0,0,8"/>
            <RadioButton x:Name="StereoRadio"
                         Content="ステレオ"
                         GroupName="Channel"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="1"
                  Header="サブキャリア"
                  Margin="4">
          <UniformGrid Columns="2"
                       Margin="3">
            <RadioButton Content="16-SC"
                         Tag="16"
                         GroupName="Subcarrier"
                         IsChecked="True"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
            <RadioButton Content="24-SC"
                         Tag="24"
                         GroupName="Subcarrier"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
            <RadioButton Content="32-SC"
                         Tag="32"
                         GroupName="Subcarrier"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
            <RadioButton Content="40-SC"
                         Tag="40"
                         GroupName="Subcarrier"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
            <RadioButton Content="48-SC"
                         Tag="48"
                         GroupName="Subcarrier"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
            <RadioButton Content="56-SC"
                         Tag="56"
                         GroupName="Subcarrier"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
            <RadioButton Content="64-SC"
                         Tag="64"
                         GroupName="Subcarrier"
                         Checked="OnSettingsChanged"
                         Margin="0,0,4,2"/>
          </UniformGrid>
        </GroupBox>

        <GroupBox Grid.Column="2"
                  Header="変調"
                  Margin="4">
          <UniformGrid Columns="2"
                       Margin="3">
            <RadioButton Content="BPSK"
                         Tag="Bpsk"
                         GroupName="Modulation"
                         IsChecked="True"
                         Checked="OnSettingsChanged"/>
            <RadioButton Content="QPSK"
                         Tag="Qpsk"
                         GroupName="Modulation"
                         Checked="OnSettingsChanged"/>
            <RadioButton Content="8PSK"
                         Tag="Psk8"
                         GroupName="Modulation"
                         Checked="OnSettingsChanged"/>
            <RadioButton Content="16QAM"
                         Tag="Qam16"
                         GroupName="Modulation"
                         Checked="OnSettingsChanged"/>
            <RadioButton Content="64QAM"
                         Tag="Qam64"
                         GroupName="Modulation"
                         Checked="OnSettingsChanged"/>
          </UniformGrid>
        </GroupBox>

        <GroupBox Grid.Column="3"
                  Header="Interleave"
                  Margin="4">
          <StackPanel Margin="2">
            <RadioButton Content="x1"
                         Tag="1"
                         GroupName="Interleave"
                         IsChecked="True"
                         Checked="OnSettingsChanged"/>
            <RadioButton Content="x2"
                         Tag="2"
                         GroupName="Interleave"
                         Checked="OnSettingsChanged"
                         Margin="0,0,0,2"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="4"
                  Header="出力"
                  Margin="4">
          <Grid Margin="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Content="送信ファイル"
                      Width="90"
                      VerticalAlignment="Center"
                      Click="OnBrowseInput"/>
              <TextBox x:Name="InputPathBox"
                       Grid.Column="1"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       IsReadOnly="True"/>
            </Grid>
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,8,0,0">
              <RadioButton x:Name="WriteWavRadio"
                           Content="WAV出力"
                           GroupName="OutputMode"
                           IsChecked="True"
                           VerticalAlignment="Center"
                           Checked="OnSettingsChanged"/>
              <RadioButton x:Name="PlayAudioRadio"
                           Content="音声出力"
                           GroupName="OutputMode"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Checked="OnSettingsChanged"/>
            </StackPanel>
            <Grid Grid.Row="2"
                  Margin="0,8,0,0">
              <StackPanel x:Name="WavOutputPanel"
                          Orientation="Horizontal"
                          VerticalAlignment="Center">
                <TextBlock Text="出力ファイル"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="WavPathBox"
                         Width="440"
                         IsReadOnly="True"
                         VerticalAlignment="Center"/>
                <Button Content="..."
                        Width="36"
                        Margin="8,0,0,0"
                        Click="OnBrowseWav"/>
              </StackPanel>
              <StackPanel x:Name="AudioOutputPanel"
                          Orientation="Horizontal"
                          VerticalAlignment="Center"
                          Visibility="Collapsed">
                <TextBlock Text="出力デバイス"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="AudioDeviceComboBox"
                          Width="160"
                          Foreground="#FF1E2024"
                          SelectedValuePath="DeviceNumber"
                          SelectionChanged="OnAudioDeviceSelectionChanged">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}"
                                 Foreground="#FF1E2024"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                  <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                      <Setter Property="Foreground"
                              Value="#FF1E2024"/>
                      <Setter Property="Background"
                              Value="White"/>
                    </Style>
                  </ComboBox.ItemContainerStyle>
                </ComboBox>
                <TextBlock Text="音量"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0"/>
                <Slider x:Name="AudioVolumeSlider"
                        Width="120"
                        Minimum="0"
                        Maximum="100"
                        Value="80"
                        TickFrequency="5"
                        IsSnapToTickEnabled="False"
                        VerticalAlignment="Center"
                        ValueChanged="OnAudioVolumeChanged"/>
                <TextBlock x:Name="AudioVolumeValueText"
                           Text="80%"
                           Width="36"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           TextAlignment="Right"/>
              </StackPanel>
            </Grid>
          </Grid>
        </GroupBox>
      </Grid>

      <StackPanel Grid.Column="1"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="16,0,4,4">
        <Button x:Name="StartButton"
                Content="スタート"
                Width="110"
                Height="34"
                Click="OnStartClick"/>
        <Button x:Name="StopButton"
                Content="ストップ"
                Width="110"
                Height="34"
                Margin="0,8,0,0"
                IsEnabled="False"
                Click="OnStopClick"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

