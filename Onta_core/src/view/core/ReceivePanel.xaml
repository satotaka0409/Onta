<UserControl x:Class="Onta.View.Core.ReceivePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:local="clr-namespace:Onta.View.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"
                           MinHeight="130"/>
        </Grid.RowDefinitions>

        <TextBlock Text="受信"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="4,0,0,8"/>

        <Grid Grid.Row="1"
              Margin="4,0,4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="File Name"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="FileNameBox"
                     Grid.Column="1"
                     IsReadOnly="True"
                     Margin="0,0,12,0"/>
            <TextBlock Grid.Column="2"
                       Text="ファイルサイズ"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="FileSizeBox"
                     Grid.Column="3"
                     IsReadOnly="True"
                     Margin="0,0,12,0"/>
            <TextBlock Grid.Column="4"
                       Text="ブロック数"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="BlockCountBox"
                     Grid.Column="5"
                     IsReadOnly="True"
                     Margin="0,0,12,0"/>
            <TextBlock Grid.Column="6"
                       Text="Progress"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="ProgressBox"
                     Grid.Column="7"
                     IsReadOnly="True"/>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="ワウフラッター"
                      Width="600"
                      Margin="0,0,8,0"
                      VerticalAlignment="Top">
                <Grid Margin="4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <local:WowFlutterMeter x:Name="WowLeft"
                                           ChannelLabel="L"
                                           Margin="0,0,6,0"/>
                    <local:WowFlutterMeter x:Name="WowRight"
                                           Grid.Column="1"
                                           ChannelLabel="R"
                                           Margin="6,0,0,0"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="入出力"
                      Margin="0,0,8,0"
                      VerticalAlignment="Top">
                <StackPanel Margin="4,2">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,6">
                        <RadioButton x:Name="WavInputRadio"
                                     Content="WAV入力"
                                     GroupName="ReceiveInputMode"
                                     IsChecked="True"
                                     VerticalAlignment="Center"
                                     Checked="OnInputModeChanged"/>
                        <RadioButton x:Name="AudioInputRadio"
                                     Content="音声入力"
                                     GroupName="ReceiveInputMode"
                                     Margin="16,0,0,0"
                                     VerticalAlignment="Center"
                                     Checked="OnInputModeChanged"/>
                    </StackPanel>
                    <Grid>
                        <StackPanel x:Name="WavInputPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,4">
                            <TextBlock Text="入力ファイル"
                                       Width="72"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBox x:Name="WavPathBox"
                                     Width="300"
                                     IsReadOnly="True"
                                     VerticalAlignment="Center"/>
                            <Button Content="..."
                                    Width="36"
                                    Margin="8,0,0,0"
                                    Click="OnBrowseWavInput"/>
                        </StackPanel>
                        <StackPanel x:Name="AudioInputPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,4"
                                    Visibility="Collapsed">
                            <TextBlock Text="入力デバイス"
                                       Width="72"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="AudioDeviceComboBox"
                                      Width="300"
                                      Foreground="#FF1E2024"
                                      SelectedValuePath="DeviceNumber"
                                      SelectionChanged="OnAudioDeviceSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#FF1E2024"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground"
                                                Value="#FF1E2024"/>
                                        <Setter Property="Background"
                                                Value="White"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="出力フォルダー"
                                   Width="72"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox x:Name="OutputDirBox"
                                 Width="300"
                                 IsReadOnly="True"
                                 VerticalAlignment="Center"/>
                        <Button Content="..."
                                Width="36"
                                Margin="8,0,0,0"
                                Click="OnBrowseOutputDir"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- スタート -->
            <Button Grid.Column="3"
                    Content="Start"
                    Width="110"
                    Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,4,0"
                    Click="OnReceiveStartClick"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>

            <TabControl Margin="0,0,8,0">
                <TabItem Header="Error Rate">
                    <Border BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Background="{StaticResource BrushInput}"
                            CornerRadius="3"
                            Padding="4">
                        <lvc:CartesianChart x:Name="ErrorChart"
                                            Background="{StaticResource BrushInput}"
                                            Series="{Binding Series}"
                                            XAxes="{Binding XAxes}"
                                            YAxes="{Binding YAxes}"
                                            AnimationsSpeed="0"
                                            TooltipPosition="Hidden"/>
                    </Border>
                </TabItem>
                <TabItem Header="FFT">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="FftTitle"
                                   Text="FFT"
                                   Margin="4,0,0,4"
                                   Foreground="{StaticResource BrushTextMuted}"/>
                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                Background="{StaticResource BrushInput}"
                                CornerRadius="3"
                                Padding="4">
                            <lvc:CartesianChart x:Name="FftChart"
                                                Background="{StaticResource BrushInput}"
                                                Series="{Binding Series}"
                                                XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxes}"
                                                AnimationsSpeed="0"
                                                TooltipPosition="Hidden"/>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="IqTitle"
                           Text="I-Q"
                           Margin="4,0,0,4"
                           Foreground="{StaticResource BrushTextMuted}"/>
                <Border Grid.Row="1"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        Background="{StaticResource BrushInput}"
                        CornerRadius="3"
                        Padding="4">
                    <lvc:CartesianChart x:Name="IqChart"
                                        Background="{StaticResource BrushInput}"
                                        Series="{Binding Series}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        AnimationsSpeed="0"
                                        TooltipPosition="Hidden"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

