<UserControl x:Class="Onta.View.Core.ReceivePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:local="clr-namespace:Onta.View.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"
                           MinHeight="130"/>
        </Grid.RowDefinitions>

        <TextBlock Text="受信"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="4,0,0,8"/>

        <Grid Grid.Row="1"
              Margin="4,0,4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="File Name"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="FileNameBox"
                     Grid.Column="1"
                     IsReadOnly="True"
                     Margin="0,0,12,0"/>
            <TextBlock Grid.Column="2"
                       Text="ファイルサイズ"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="FileSizeBox"
                     Grid.Column="3"
                     IsReadOnly="True"
                     Margin="0,0,12,0"/>
            <TextBlock Grid.Column="4"
                       Text="ブロック数"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="BlockCountBox"
                     Grid.Column="5"
                     IsReadOnly="True"
                     Margin="0,0,12,0"/>
            <TextBlock Grid.Column="6"
                       Text="Progress"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="ProgressBox"
                     Grid.Column="7"
                     IsReadOnly="True"/>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"
                                   MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="ワウフラッター"
                      Width="420"
                      Margin="0,0,8,0"
                      VerticalAlignment="Top">
                <Grid Margin="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <local:WowFlutterMeter x:Name="WowLeft"
                                           ChannelLabel="L"
                                           Margin="0,0,6,0"/>
                    <local:WowFlutterMeter x:Name="WowRight"
                                           Grid.Column="1"
                                           ChannelLabel="R"
                                           Margin="6,0,0,0"/>
                </Grid>
            </GroupBox>

            <GroupBox x:Name="IoGroupBox"
                      Grid.Column="1"
                      Header="入出力"
                      VerticalAlignment="Top">
                <Grid Margin="4,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,6">
                        <RadioButton x:Name="WavInputRadio"
                                     Content="WAV入力"
                                     GroupName="ReceiveInputMode"
                                     IsChecked="True"
                                     VerticalAlignment="Center"
                                     Checked="OnInputModeChanged"/>
                        <RadioButton x:Name="AudioInputRadio"
                                     Content="音声入力"
                                     GroupName="ReceiveInputMode"
                                     Margin="16,0,0,0"
                                     VerticalAlignment="Center"
                                     Checked="OnInputModeChanged"/>
                    </StackPanel>
                    <Grid Grid.Row="1"
                          Margin="0,0,0,4">
                        <Grid x:Name="WavInputPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="入力ファイル"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBox x:Name="WavPathBox"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     VerticalAlignment="Center"/>
                            <Button Grid.Column="2"
                                    Content="..."
                                    Width="36"
                                    Margin="8,0,0,0"
                                    Click="OnBrowseWavInput"/>
                        </Grid>
                        <Grid x:Name="AudioInputPanel"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="入力デバイス"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="AudioDeviceComboBox"
                                      Grid.Column="1"
                                      Foreground="#FF1E2024"
                                      SelectedValuePath="DeviceNumber"
                                      SelectionChanged="OnAudioDeviceSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#FF1E2024"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground"
                                                Value="#FF1E2024"/>
                                        <Setter Property="Background"
                                                Value="White"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="出力フォルダー"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox x:Name="OutputDirBox"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="..."
                                Width="36"
                                Margin="8,0,0,0"
                                Click="OnBrowseOutputDir"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- スタート（入出力との間隔 16px。常に見える列幅） -->
            <Button x:Name="StartButton"
                    Grid.Column="2"
                    Content="スタート"
                    Width="110"
                    Height="34"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="16,8,4,0"
                    Click="OnReceiveStartClick"/>
        </Grid>

        <Grid x:Name="ReceiveGraphsRow"
              Grid.Row="3"
              SizeChanged="OnReceiveGraphsRowSizeChanged">
            <Grid.ColumnDefinitions>
                <!-- 左: FFT/エラーレート（残り幅） / 右: I-Q（正方形固定枠） -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- TabItem 内に置くと非選択時 ActualSize=0 になり LiveCharts が描画不能になるため、切替は Visibility で行う -->
            <Grid Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton x:Name="ErrorRateTabRadio"
                                 Content="エラーレート"
                                 GroupName="ReceiveGraphTab"
                                 IsChecked="True"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"/>
                    <RadioButton x:Name="FftTabRadio"
                                 Content="FFT"
                                 GroupName="ReceiveGraphTab"
                                 VerticalAlignment="Center"/>
                    <StackPanel x:Name="ErrorRateLegend"
                                Orientation="Horizontal"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center">
                        <Border Width="12"
                                Height="3"
                                Background="#FF64AAFF"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"/>
                        <TextBlock Text="青: ビタビ（畳み込み・ブロック単位）"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,0,14,0"/>
                        <Border Width="12"
                                Height="3"
                                Background="#FFFF9646"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"/>
                        <TextBlock Text="橙: RS／ターボ（ターボは1024B単位）"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>
                </StackPanel>
                <Border x:Name="ErrorChartHost"
                        Grid.Row="1"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        Background="{StaticResource BrushInput}"
                        CornerRadius="3"
                        Padding="4"
                        ClipToBounds="True">
                    <lvc:CartesianChart x:Name="ErrorChart"
                                        Background="{StaticResource BrushInput}"
                                        AnimationsSpeed="0"
                                        TooltipPosition="Hidden"/>
                </Border>
                <Border x:Name="FftChartHost"
                        Grid.Row="1"
                        Opacity="0"
                        IsHitTestVisible="False"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        Background="{StaticResource BrushInput}"
                        CornerRadius="3"
                        Padding="4"
                        ClipToBounds="True">
                    <lvc:CartesianChart x:Name="FftChart"
                                        Background="{StaticResource BrushInput}"
                                        AnimationsSpeed="0"
                                        TooltipPosition="Hidden"/>
                </Border>
            </Grid>

            <Grid x:Name="IqPanelHost"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Right"
                  Width="220"
                  Height="240">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="IqTitle"
                           Text="I-Q"
                           Margin="4,0,0,4"
                           Foreground="{StaticResource BrushTextMuted}"/>
                <Border x:Name="IqChartBorder"
                        Grid.Row="1"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        Background="{StaticResource BrushInput}"
                        CornerRadius="3"
                        Padding="4"
                        ClipToBounds="True">
                    <lvc:CartesianChart x:Name="IqChart"
                                        Background="{StaticResource BrushInput}"
                                        AnimationsSpeed="0"
                                        TooltipPosition="Hidden"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

