<UserControl x:Class="Onta.View.Core.ReceiveDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <DataGrid x:Name="DetailGrid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserResizeRows="False"
              IsReadOnly="True"
              HeadersVisibility="Column"
              GridLinesVisibility="All"
              SelectionMode="Single"
              SelectionUnit="FullRow">
      <DataGrid.Columns>
        <DataGridTextColumn Header="項目"
            Binding="{Binding Name}"
            Width="1.6*"/>
        <DataGridTextColumn Header="結果"
            Binding="{Binding ResultText}"
            Width="0.8*"/>
        <DataGridTextColumn Header="サイズ"
            Binding="{Binding SizeText}"
            Width="0.9*"/>
        <DataGridTextColumn Header="stereo/mono"
            Binding="{Binding ChannelText}"
            Width="*"/>
        <DataGridTextColumn Header="サブキャリア数"
            Binding="{Binding SubcarrierText}"
            Width="*"/>
        <DataGridTextColumn Header="変調"
            Binding="{Binding ModulationText}"
            Width="0.9*"/>
        <DataGridTemplateColumn Header="メーター"
            Width="1.4*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ProgressBar Height="14"
                           Margin="2,0"
                           Minimum="0"
                           Maximum="100"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           Value="{Binding ProgressPercent, Mode=OneWay}"
                           Visibility="{Binding MeterVisibility}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
