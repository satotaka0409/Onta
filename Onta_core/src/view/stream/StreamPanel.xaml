<UserControl x:Class="Onta.View.Stream.StreamPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:core="clr-namespace:Onta.View.Core">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 送信 -->
    <Border Grid.Row="0"
            Style="{StaticResource PanelBorder}"
            Margin="0,0,0,8"
            Padding="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="TxSpeedHost"
                    Grid.Column="0"
                    Margin="0,0,16,0">
          <TextBlock Text="送信"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Margin="0,0,0,8"/>
          <GroupBox Header="速度"
                    Style="{StaticResource GroupBoxCompact}">
            <UniformGrid Columns="3"
                         Margin="2">
              <RadioButton x:Name="Rate18Radio"
                           GroupName="StreamRate"
                           Content="18Kbps"
                           Tag="1"
                           IsChecked="True"
                           Margin="0,0,8,4"/>
              <RadioButton GroupName="StreamRate"
                           Content="20Kbps"
                           Tag="2"
                           Margin="0,0,8,4"/>
              <RadioButton GroupName="StreamRate"
                           Content="23Kbps"
                           Tag="3"
                           Margin="0,0,8,4"/>
              <RadioButton GroupName="StreamRate"
                           Content="24Kbps"
                           Tag="4"
                           Margin="0,0,8,4"/>
              <RadioButton GroupName="StreamRate"
                           Content="28Kbps"
                           Tag="5"
                           Margin="0,0,8,4"/>
              <RadioButton GroupName="StreamRate"
                           Content="30Kbps"
                           Tag="6"
                           Margin="0,0,8,4"/>
            </UniformGrid>
          </GroupBox>
        </StackPanel>

        <GroupBox x:Name="TxIoHost"
                  Grid.Column="1"
                  Header="入出力"
                  Style="{StaticResource GroupBoxCompact}">
          <Grid Margin="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TxWavRadio"
                             GroupName="StreamTxIn"
                             Content="ファイル入力"
                             IsChecked="True"
                             VerticalAlignment="Center"
                             Checked="OnTxInputModeChanged"/>
              <RadioButton x:Name="TxAudioRadio"
                           GroupName="StreamTxIn"
                           Content="音声入力"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Checked="OnTxInputModeChanged"/>
            </StackPanel>
            <Grid Grid.Row="1"
                  Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid>
                <StackPanel x:Name="TxWavInputPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                  <TextBlock Text="入力ファイル"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                  <TextBox x:Name="TxWavPathBox"
                           Width="280"
                           MinWidth="100"
                           IsReadOnly="True"
                           VerticalAlignment="Center"/>
                  <Button Content="..."
                          Width="45"
                          Margin="8,0,0,0"
                          Click="OnBrowseTxWav"/>
                </StackPanel>
                <StackPanel x:Name="TxAudioInputPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                  <TextBlock Text="入力デバイス"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                  <ComboBox x:Name="TxInputDeviceBox"
                            Width="180">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{StaticResource BrushComboForeground}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="音量"
                             VerticalAlignment="Center"
                             Margin="12,0,6,0"/>
                  <Slider x:Name="TxInputVolume"
                          Width="100"
                          Minimum="0"
                          Maximum="1"
                          Value="1"
                          VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="2"
                          Orientation="Horizontal"
                          VerticalAlignment="Center">
                <TextBlock Text="出力デバイス"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="TxOutputDeviceBox"
                          Width="140">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 Foreground="{StaticResource BrushComboForeground}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="音量"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0"/>
                <Slider x:Name="TxOutputVolume"
                        Width="100"
                        Minimum="0"
                        Maximum="1"
                        Value="0.8"
                        VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Grid>
        </GroupBox>

        <Grid Grid.Column="2"
              Grid.Row="0"
              Grid.RowSpan="2"
              VerticalAlignment="Stretch"
              Margin="12,0,0,0">
          <TextBlock x:Name="TxStatusText"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Right"
                     Width="120"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource BrushTextMuted}"/>
          <StackPanel VerticalAlignment="Bottom"
                      HorizontalAlignment="Right">
            <Button x:Name="TxStartButton"
                    Content="スタート"
                    Width="96"
                    Height="34"
                    Click="OnTxStart"/>
            <Button x:Name="TxStopButton"
                    Content="ストップ"
                    Width="96"
                    Height="34"
                    Margin="0,8,0,0"
                    IsEnabled="False"
                    Click="OnTxStop"/>
          </StackPanel>
        </Grid>

        <!-- 曲情報・ジャケ写：右端を入出力 GroupBox に合わせる -->
        <Grid x:Name="TxMetaHost"
              Grid.Row="1"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Margin="0,8,0,0"
              HorizontalAlignment="Stretch">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Text="曲タイトル"
                     HorizontalAlignment="Left"
                     TextAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="0,0,8,0"/>
          <TextBox x:Name="TxTitleBox"
                   Grid.Column="1"
                   Width="350"
                   MaxLength="256"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"/>

          <TextBlock Grid.Row="1"
                     Text="アーティスト"
                     HorizontalAlignment="Left"
                     TextAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="0,8,8,0"/>
          <TextBox x:Name="TxArtistBox"
                   Grid.Row="1"
                   Grid.Column="1"
                   Width="350"
                   MaxLength="256"
                   HorizontalAlignment="Left"
                   Margin="0,8,0,0"
                   VerticalAlignment="Top"/>

          <Grid Grid.Column="2"
                Grid.RowSpan="2"
                VerticalAlignment="Top"
                Margin="16,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="ジャケ写"
                       VerticalAlignment="Center"
                       Margin="0,0,0,4"/>
            <Button Grid.Row="1"
                    Content="ファイル指定"
                    Width="90"
                    VerticalAlignment="Center"
                    Click="OnBrowseCover"/>
            <TextBox x:Name="TxCoverPathBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Width="340"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     IsReadOnly="True"/>
          </Grid>
          <StackPanel Grid.Column="4"
                      Grid.RowSpan="2"
                      Margin="0,0,12,0"
                      VerticalAlignment="Top">
            <RadioButton x:Name="Cover32Radio"
                         GroupName="CoverFmt"
                         Content="32x32カラー"
                         IsChecked="True"
                         Checked="OnCoverFormatChanged"/>
            <RadioButton GroupName="CoverFmt"
                         Content="48x48カラー"
                         Tag="Color48"
                         Checked="OnCoverFormatChanged"/>
            <RadioButton GroupName="CoverFmt"
                         Content="48x48白黒"
                         Tag="Gray48"
                         Checked="OnCoverFormatChanged"/>
            <RadioButton GroupName="CoverFmt"
                         Content="64x64白黒"
                         Tag="Gray64"
                         Checked="OnCoverFormatChanged"/>
            <TextBlock x:Name="CoverBytesText"
                       Margin="0,4,0,0"
                       Text="バイト数: 0"/>
            <TextBlock x:Name="CoverSizeOverText"
                       Text="サイズオーバー"
                       Margin="0,2,0,0"
                       Foreground="Red"
                       Visibility="Hidden"/>
          </StackPanel>
          <StackPanel Grid.Column="5"
                      Grid.RowSpan="2"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Right">
            <Border Width="96"
                    Height="96"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    Background="{StaticResource BrushInput}">
              <Image x:Name="TxCoverPreview"
                     Stretch="Uniform"/>
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- 受信 -->
    <Border Grid.Row="1"
            Style="{StaticResource PanelBorder}"
            Padding="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <!-- 性能測定 L 行相当の高さ。下段 * は空白のまま残す -->
          <RowDefinition Height="280"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel>
            <TextBlock Text="受信"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8">
              <TextBlock Text="速度"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
              <TextBox x:Name="RxRateBox"
                       Width="80"
                       IsReadOnly="True"
                       Margin="0,0,16,0"/>
              <TextBlock Text="入力デバイス"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
              <ComboBox x:Name="RxInputDeviceBox"
                        Width="160"
                        Margin="0,0,8,0">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Foreground="{StaticResource BrushComboForeground}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="音量"
                         VerticalAlignment="Center"
                         Margin="0,0,4,0"/>
              <Slider x:Name="RxInputVolume"
                      Width="120"
                      Minimum="0"
                      Maximum="1"
                      Value="1"/>
            </StackPanel>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"
                                  MinWidth="200"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Text="曲タイトル"
                         VerticalAlignment="Top"
                         Margin="0,0,8,0"/>
              <TextBox x:Name="RxTitleBox"
                       Grid.Column="1"
                       Height="24"
                       VerticalAlignment="Top"
                       VerticalContentAlignment="Center"
                       IsReadOnly="True"/>

              <TextBlock Grid.Row="1"
                         Text="アーティスト"
                         VerticalAlignment="Top"
                         Margin="0,8,8,0"/>
              <TextBox x:Name="RxArtistBox"
                       Grid.Row="1"
                       Grid.Column="1"
                       Height="24"
                       Margin="0,8,0,0"
                       VerticalAlignment="Top"
                       VerticalContentAlignment="Center"
                       IsReadOnly="True"/>

              <StackPanel Grid.Column="3"
                          Grid.RowSpan="2"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0">
                <TextBlock Text="ジャケ写"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="RxCoverSizeText"
                           Text="サイズ: -"/>
                <TextBlock x:Name="RxCoverBytesText"
                           Text="バイト数: 0"
                           Margin="0,2,0,0"/>
              </StackPanel>
              <Border Grid.Column="4"
                      Grid.RowSpan="2"
                      Width="96"
                      Height="96"
                      VerticalAlignment="Center"
                      BorderBrush="{StaticResource BrushBorder}"
                      BorderThickness="1"
                      Background="{StaticResource BrushInput}">
                <Image x:Name="RxCoverImage"
                       Stretch="Uniform"/>
              </Border>
            </Grid>
          </StackPanel>

          <Grid Grid.Column="1"
                VerticalAlignment="Stretch"
                Margin="16,0,0,0">
            <TextBlock x:Name="RxStatusText"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Right"
                       Width="120"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextMuted}"/>
            <StackPanel VerticalAlignment="Bottom"
                        HorizontalAlignment="Right">
              <Button x:Name="RxStartButton"
                      Content="スタート"
                      Width="96"
                      Height="34"
                      Click="OnRxStart"/>
              <Button x:Name="RxStopButton"
                      Content="ストップ"
                      Width="96"
                      Height="34"
                      Margin="0,8,0,0"
                      IsEnabled="False"
                      Click="OnRxStop"/>
            </StackPanel>
          </Grid>
        </Grid>

        <Grid x:Name="StreamGraphsRow"
              Grid.Row="1"
              SizeChanged="OnStreamGraphsRowSizeChanged">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Grid x:Name="StreamLeftGraphColumn"
                Margin="0,0,8,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,4">
              <RadioButton x:Name="StreamErrorRateTabRadio"
                           Content="エラーレート"
                           GroupName="StreamGraphTab"
                           IsChecked="True"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Checked="OnStreamGraphTabChanged"/>
              <RadioButton x:Name="StreamFftTabRadio"
                           Content="FFT"
                           GroupName="StreamGraphTab"
                           VerticalAlignment="Center"
                           Checked="OnStreamGraphTabChanged"/>
              <StackPanel x:Name="StreamFftLegend"
                          Orientation="Horizontal"
                          Margin="20,0,0,0"
                          VerticalAlignment="Center"
                          Visibility="Collapsed">
                <Border Width="12"
                        Height="3"
                        Background="#FFA6DDB0"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"/>
                <TextBlock Text="L"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextMuted}"
                           Margin="0,0,14,0"/>
                <Border Width="12"
                        Height="3"
                        Background="#FFFFB678"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"/>
                <TextBlock Text="R"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextMuted}"/>
              </StackPanel>
            </StackPanel>
            <Border x:Name="StreamErrorChartHost"
                    Grid.Row="1"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    Background="{StaticResource BrushInput}"
                    CornerRadius="3"
                    Padding="4"
                    ClipToBounds="True">
              <lvc:CartesianChart x:Name="RxErrorChart"
                                  Background="{StaticResource BrushInput}"
                                  AnimationsSpeed="0"
                                  TooltipPosition="Hidden"
                                  LegendPosition="Hidden"/>
            </Border>
            <Border x:Name="StreamFftChartHost"
                    Grid.Row="1"
                    Opacity="0"
                    IsHitTestVisible="False"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    Background="{StaticResource BrushInput}"
                    CornerRadius="3"
                    Padding="4"
                    ClipToBounds="False">
              <lvc:CartesianChart x:Name="RxFftChart"
                                  Background="{StaticResource BrushInput}"
                                  ClipToBounds="False"
                                  AnimationsSpeed="0"
                                  TooltipPosition="Hidden"
                                  LegendPosition="Hidden"/>
            </Border>
          </Grid>

          <Grid x:Name="StreamIqPanelHost"
                Grid.Column="1"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Right"
                Width="260">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StreamIqTitle"
                       Text="I-Q"
                       Margin="4,0,0,4"
                       Foreground="{StaticResource BrushTextMuted}"/>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="StreamIqHost"
                      BorderBrush="{StaticResource BrushBorder}"
                      BorderThickness="1"
                      CornerRadius="3"
                      Background="{StaticResource BrushInput}"
                      Padding="4"
                      ClipToBounds="True">
                <lvc:CartesianChart x:Name="RxIqChart"
                                    Width="240"
                                    Height="240"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource BrushInput}"
                                    AnimationsSpeed="0"
                                    TooltipPosition="Hidden"
                                    LegendPosition="Hidden"/>
              </Border>
              <StackPanel x:Name="StreamIqGroupLegend"
                          Grid.Column="1"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
