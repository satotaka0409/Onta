<UserControl x:Class="Onta.View.Stream.StreamPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:lang="clr-namespace:Onta.View.Language"
             xmlns:core="clr-namespace:Onta.View.Core">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 送信 -->
    <Border Grid.Row="0"
            Style="{StaticResource PanelBorder}"
            Margin="0,0,0,8"
            Padding="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="TxSpeedHost"
                    Grid.Column="0"
                    Margin="0,0,16,0">
          <TextBlock Text="{x:Static lang:CoreViewText.Send}"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Margin="0,0,0,8"/>
          <GroupBox Header="{x:Static lang:CoreViewText.StreamRate}"
                    Style="{StaticResource GroupBoxCompact}">
            <UniformGrid Columns="3"
                         Margin="2">
              <RadioButton x:Name="Rate18Radio"
                           GroupName="StreamRate" Checked="OnTxRateChanged"
                           Content="18Kbps"
                           Tag="1"
                           IsChecked="True"
                           Margin="0,0,8,4"/>
              <RadioButton GroupName="StreamRate" Checked="OnTxRateChanged"
                           Content="20Kbps"
                           Tag="2"
                           Margin="0,0,8,4"/>
              <RadioButton GroupName="StreamRate" Checked="OnTxRateChanged"
                           Content="23Kbps"
                           Tag="3"
                           Margin="0,0,8,4"/>
              <RadioButton GroupName="StreamRate" Checked="OnTxRateChanged"
                           Content="24Kbps"
                           Tag="4"
                           Margin="0,0,8,4"/>
              <RadioButton GroupName="StreamRate" Checked="OnTxRateChanged"
                           Content="28Kbps"
                           Tag="5"
                           Margin="0,0,8,4"/>
              <RadioButton GroupName="StreamRate" Checked="OnTxRateChanged"
                           Content="30Kbps"
                           Tag="6"
                           Margin="0,0,8,4"/>
              <RadioButton GroupName="StreamRate" Checked="OnTxRateChanged"
                           Content="33Kbps"
                           Tag="7"
                           Margin="0,0,8,4"/>
              <RadioButton GroupName="StreamRate" Checked="OnTxRateChanged"
                           Content="44Kbps"
                           Tag="8"
                           Margin="0,0,8,4"/>
              <RadioButton GroupName="StreamRate" Checked="OnTxRateChanged"
                           Content="50Kbps"
                           Tag="9"
                           Margin="0,0,8,4"/>
            </UniformGrid>
          </GroupBox>
        </StackPanel>

        <GroupBox x:Name="TxIoHost"
                  Grid.Column="1"
                  Header="{x:Static lang:CoreViewText.StreamIo}"
                  Style="{StaticResource GroupBoxCompact}">
          <Grid Margin="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="TxWavRadio"
                           GroupName="StreamTxIn"
                           Content="{x:Static lang:CoreViewText.StreamFileInput}"
                           IsChecked="True"
                           VerticalAlignment="Center"
                           Checked="OnTxInputModeChanged"/>
              <RadioButton x:Name="TxAudioRadio"
                           GroupName="StreamTxIn"
                           Content="{x:Static lang:CoreViewText.AudioInput}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Checked="OnTxInputModeChanged"/>
            </StackPanel>
            <Grid Grid.Row="1"
                  Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid>
                <StackPanel x:Name="TxWavInputPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                  <TextBlock Text="{x:Static lang:CoreViewText.InputFile}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                  <TextBox x:Name="TxWavPathBox"
                           Width="280"
                           MinWidth="100"
                           IsReadOnly="True"
                           VerticalAlignment="Center"
                           AllowDrop="True"
                           PreviewDragOver="OnTxWavDragOver"
                           Drop="OnTxWavDrop"/>
                  <Button Content="..."
                          Width="45"
                          Margin="8,0,0,0"
                          Click="OnBrowseTxWav"/>
                </StackPanel>
                <StackPanel x:Name="TxAudioInputPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                  <TextBlock Text="{x:Static lang:CoreViewText.InputDevice}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                  <ComboBox x:Name="TxInputDeviceBox"
                            Width="180">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{StaticResource BrushComboForeground}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{x:Static lang:CoreViewText.Volume}"
                             VerticalAlignment="Center"
                             Margin="12,0,6,0"/>
                  <Slider x:Name="TxInputVolume"
                          Width="100"
                          Minimum="0"
                          Maximum="100"
                          Value="100"
                          TickFrequency="5"
                          IsSnapToTickEnabled="False"
                          VerticalAlignment="Center"
                          ValueChanged="OnStreamVolumeChanged"/>
                  <TextBlock x:Name="TxInputVolumeValueText"
                             Text="100%"
                             Width="36"
                             Margin="6,0,0,0"
                             VerticalAlignment="Center"
                             TextAlignment="Right"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="2"
                          Orientation="Horizontal"
                          VerticalAlignment="Center">
                <TextBlock Text="{x:Static lang:CoreViewText.OutputDevice}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="TxOutputDeviceBox"
                          Width="140"
                          SelectionChanged="OnTxOutputDeviceChanged">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}"
                                 Foreground="{StaticResource BrushComboForeground}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{x:Static lang:CoreViewText.Volume}"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0"/>
                <Slider x:Name="TxOutputVolume"
                        Width="100"
                        Minimum="0"
                        Maximum="100"
                        Value="80"
                        TickFrequency="5"
                        IsSnapToTickEnabled="False"
                        VerticalAlignment="Center"
                        ValueChanged="OnStreamVolumeChanged"/>
                <TextBlock x:Name="TxOutputVolumeValueText"
                           Text="80%"
                           Width="36"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           TextAlignment="Right"/>
              </StackPanel>
            </Grid>
          </Grid>
        </GroupBox>

        <Grid Grid.Column="2"
              Grid.Row="0"
              Grid.RowSpan="2"
              VerticalAlignment="Stretch"
              Margin="12,0,0,0">
          <TextBlock x:Name="TxStatusText"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Right"
                     Width="120"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource BrushTextMuted}"/>
          <StackPanel VerticalAlignment="Bottom"
                      HorizontalAlignment="Right">
            <Button x:Name="TxStartButton"
                    Content="{x:Static lang:CoreViewText.Start}"
                    Width="96"
                    Height="34"
                    Click="OnTxStart"/>
            <Button x:Name="TxStopButton"
                    Content="{x:Static lang:CoreViewText.Stop}"
                    Width="96"
                    Height="34"
                    Margin="0,8,0,0"
                    IsEnabled="False"
                    Click="OnTxStop"/>
          </StackPanel>
        </Grid>

        <!-- 曲情報・ジャケ写：右端を入出力 GroupBox に合わせる -->
        <GroupBox x:Name="TxMetaHost"
                  Grid.Row="1"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Header="{x:Static lang:CoreViewText.TrackInfo}"
                  Style="{StaticResource GroupBoxCompact}"
                  Margin="0,8,0,0"
                  HorizontalAlignment="Stretch">
          <Grid Margin="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Static lang:CoreViewText.TrackTitle}"
                       HorizontalAlignment="Left"
                       TextAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="TxTitleBox"
                     Grid.Column="1"
                     Width="770"
                     MaxLength="256"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"/>

            <TextBlock Grid.Row="1"
                       Text="{x:Static lang:CoreViewText.Artist}"
                       HorizontalAlignment="Left"
                       TextAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="0,8,8,0"/>
            <TextBox x:Name="TxArtistBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Width="770"
                     MaxLength="256"
                     HorizontalAlignment="Left"
                     Margin="0,8,0,0"
                     VerticalAlignment="Top"/>

            <TextBlock Grid.Row="2"
                       Text="{x:Static lang:CoreViewText.CoverArt}"
                       HorizontalAlignment="Left"
                       TextAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="0,8,8,0"/>
            <Grid Grid.Row="2"
                  Grid.Column="1"
                  Width="770"
                  HorizontalAlignment="Left"
                  Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Content="{x:Static lang:CoreViewText.SelectFile}"
                      Width="90"
                      VerticalAlignment="Center"
                      Click="OnBrowseCover"/>
              <Button Grid.Column="1"
                      Content="{x:Static lang:CoreViewText.ClearSelection}"
                      Width="60"
                      Margin="6,0,0,0"
                      VerticalAlignment="Center"
                      Click="OnClearCover"/>
              <TextBox x:Name="TxCoverPathBox"
                       Grid.Column="2"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       IsReadOnly="True"/>
            </Grid>
            <StackPanel Grid.Column="4"
                        Grid.RowSpan="3"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top">
              <RadioButton x:Name="Cover32Radio"
                           GroupName="CoverFmt"
                           Content="{x:Static lang:CoreViewText.CoverFmt32Color}"
                           IsChecked="True"
                           Checked="OnCoverFormatChanged"/>
              <RadioButton GroupName="CoverFmt"
                           Content="{x:Static lang:CoreViewText.CoverFmt48Color}"
                           Tag="Color48"
                           Checked="OnCoverFormatChanged"/>
              <RadioButton GroupName="CoverFmt"
                           Content="{x:Static lang:CoreViewText.CoverFmt48Gray}"
                           Tag="Gray48"
                           Checked="OnCoverFormatChanged"/>
              <RadioButton GroupName="CoverFmt"
                           Content="{x:Static lang:CoreViewText.CoverFmt64Gray}"
                           Tag="Gray64"
                           Checked="OnCoverFormatChanged"/>
              <TextBlock x:Name="CoverBytesText"
                         Margin="0,4,0,0"
                         Text="{x:Static lang:CoreViewText.ByteCount0}"/>
              <TextBlock x:Name="CoverSizeOverText"
                         Text="{x:Static lang:CoreViewText.SizeOver}"
                         Margin="0,2,0,0"
                         Foreground="Red"
                         Visibility="Hidden"/>
            </StackPanel>
            <StackPanel Grid.Column="5"
                        Grid.RowSpan="3"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right">
              <Border Width="96"
                      Height="96"
                      BorderBrush="{StaticResource BrushBorder}"
                      BorderThickness="1"
                      Background="{StaticResource BrushInput}"
                      AllowDrop="True"
                      PreviewDragOver="OnTxCoverDragOver"
                      Drop="OnTxCoverDrop">
                <Image x:Name="TxCoverPreview"
                       Stretch="Uniform"
                       IsHitTestVisible="False"/>
              </Border>
            </StackPanel>
          </Grid>
        </GroupBox>
      </Grid>
    </Border>

    <!-- 受信 -->
    <Border Grid.Row="1"
            Style="{StaticResource PanelBorder}"
            Padding="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <!-- 性能測定 L 行相当の高さ。下段 * は空白のまま残す -->
          <RowDefinition Height="280"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel>
            <TextBlock Text="{x:Static lang:CoreViewText.Receive}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8">
              <TextBlock Text="{x:Static lang:CoreViewText.StreamRate}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
              <TextBox x:Name="RxRateBox"
                       Width="80"
                       IsReadOnly="True"
                       Margin="0,0,16,0"/>
              <TextBlock Text="{x:Static lang:CoreViewText.InputDevice}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
              <ComboBox x:Name="RxInputDeviceBox"
                        Width="160"
                        Margin="0,0,8,0">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}"
                               Foreground="{StaticResource BrushComboForeground}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{x:Static lang:CoreViewText.Volume}"
                         VerticalAlignment="Center"
                         Margin="0,0,4,0"/>
              <Slider x:Name="RxInputVolume"
                      Width="120"
                      Minimum="0"
                      Maximum="100"
                      Value="80"
                      TickFrequency="5"
                      IsSnapToTickEnabled="False"
                      VerticalAlignment="Center"
                      ValueChanged="OnStreamVolumeChanged"/>
              <TextBlock x:Name="RxInputVolumeValueText"
                         Text="80%"
                         Width="36"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center"
                         TextAlignment="Right"/>
              <TextBlock Text="{x:Static lang:CoreViewText.OutputDevice}"
                         VerticalAlignment="Center"
                         Margin="24,0,8,0"/>
              <ComboBox x:Name="RxOutputDeviceBox"
                        Width="160"
                        Margin="0,0,8,0">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}"
                               Foreground="{StaticResource BrushComboForeground}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{x:Static lang:CoreViewText.Volume}"
                         VerticalAlignment="Center"
                         Margin="0,0,4,0"/>
              <Slider x:Name="RxOutputVolume"
                      Width="120"
                      Minimum="0"
                      Maximum="100"
                      Value="80"
                      TickFrequency="5"
                      IsSnapToTickEnabled="False"
                      VerticalAlignment="Center"
                      ValueChanged="OnStreamVolumeChanged"/>
              <TextBlock x:Name="RxOutputVolumeValueText"
                         Text="80%"
                         Width="36"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center"
                         TextAlignment="Right"/>
            </StackPanel>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <GroupBox Header="{x:Static lang:CoreViewText.WowFlutter}"
                        Style="{StaticResource GroupBoxCompact}"
                        Width="420"
                        Height="130"
                        VerticalAlignment="Top"
                        Margin="0,0,16,0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <core:WowFlutterMeter x:Name="RxWowLeft"
                                          ChannelLabel="L"
                                          Margin="0,0,2,0"/>
                    <core:WowFlutterMeter x:Name="RxWowRight"
                                          Grid.Column="1"
                                          ChannelLabel="R"
                                          Margin="2,0,0,0"/>
                  </Grid>
                  <lvc:CartesianChart x:Name="RxWowChart"
                                      Grid.Row="1"
                                      Margin="0,4,0,0"
                                      Background="{StaticResource BrushInput}"
                                      AnimationsSpeed="0"
                                      TooltipPosition="Hidden"
                                      LegendPosition="Hidden"/>
                </Grid>
              </GroupBox>

              <GroupBox Grid.Column="1"
                        Header="{x:Static lang:CoreViewText.TrackInfo}"
                        Style="{StaticResource GroupBoxCompact}"
                        Height="130"
                        VerticalAlignment="Top">
                <Grid Margin="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"
                                      MinWidth="200"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <Grid VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="32"/>
                      <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{x:Static lang:CoreViewText.TrackTitle}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox x:Name="RxTitleBox"
                             Grid.Column="1"
                             Height="24"
                             Margin="8,8,20,0"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"/>

                    <TextBlock Grid.Row="1"
                               Text="{x:Static lang:CoreViewText.Artist}"
                               VerticalAlignment="Center"
                               Margin="0,8,8,0"/>
                    <TextBox x:Name="RxArtistBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Height="24"
                             Margin="8,8,20,0"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"/>
                  </Grid>

                  <StackPanel Grid.Column="2"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0">
                    <TextBlock Text="{x:Static lang:CoreViewText.CoverArt}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="RxCoverSizeText"
                               Text="{x:Static lang:CoreViewText.SizeLabelUnknown}"/>
                    <TextBlock x:Name="RxCoverBytesText"
                               Text="{x:Static lang:CoreViewText.ByteCount0}"
                               Margin="0,2,0,0"/>
                    <TextBlock x:Name="RxCoverRateText"
                               Text="{x:Static lang:CoreViewText.CoverRateUnknown}"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="3"
                          Width="96"
                          Height="96"
                          VerticalAlignment="Center"
                          BorderBrush="{StaticResource BrushBorder}"
                          BorderThickness="1"
                          Background="{StaticResource BrushInput}">
                    <Image x:Name="RxCoverImage"
                           Stretch="Uniform"/>
                  </Border>
                </Grid>
              </GroupBox>
            </Grid>
          </StackPanel>

          <Grid Grid.Column="1"
                VerticalAlignment="Stretch"
                Margin="16,0,0,0">
            <TextBlock x:Name="RxStatusText"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Right"
                       Width="120"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextMuted}"/>
            <StackPanel VerticalAlignment="Bottom"
                        HorizontalAlignment="Right">
              <Button x:Name="RxStartButton"
                      Content="{x:Static lang:CoreViewText.Start}"
                      Width="96"
                      Height="34"
                      Click="OnRxStart"/>
              <Button x:Name="RxStopButton"
                      Content="{x:Static lang:CoreViewText.Stop}"
                      Width="96"
                      Height="34"
                      Margin="0,8,0,0"
                      IsEnabled="False"
                      Click="OnRxStop"/>
            </StackPanel>
          </Grid>
        </Grid>

        <Grid x:Name="StreamGraphsRow"
              Grid.Row="1"
              SizeChanged="OnStreamGraphsRowSizeChanged">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Grid x:Name="StreamLeftGraphColumn"
                Margin="0,0,8,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,4">
              <RadioButton x:Name="StreamErrorRateTabRadio"
                           Content="{x:Static lang:CoreViewText.ErrorRateWithEllipse}"
                           GroupName="StreamGraphTab"
                           IsChecked="True"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Checked="OnStreamGraphTabChanged"/>
              <RadioButton x:Name="StreamFftTabRadio"
                           Content="FFT"
                           GroupName="StreamGraphTab"
                           VerticalAlignment="Center"
                           Checked="OnStreamGraphTabChanged"/>
              <StackPanel x:Name="StreamFftLegend"
                          Orientation="Horizontal"
                          Margin="20,0,0,0"
                          VerticalAlignment="Center"
                          Visibility="Collapsed">
                <Border Width="12"
                        Height="3"
                        Background="#FFA6DDB0"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"/>
                <TextBlock Text="L"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextMuted}"
                           Margin="0,0,14,0"/>
                <Border Width="12"
                        Height="3"
                        Background="#FFFFB678"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"/>
                <TextBlock Text="R"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextMuted}"/>
              </StackPanel>
            </StackPanel>
            <Border x:Name="StreamErrorChartHost"
                    Grid.Row="1"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    Background="{StaticResource BrushInput}"
                    CornerRadius="3"
                    Padding="4"
                    ClipToBounds="True">
              <lvc:CartesianChart x:Name="RxErrorChart"
                                  Background="{StaticResource BrushInput}"
                                  AnimationsSpeed="0"
                                  TooltipPosition="Hidden"
                                  LegendPosition="Hidden"/>
            </Border>
            <Border x:Name="StreamFftChartHost"
                    Grid.Row="1"
                    Opacity="0"
                    IsHitTestVisible="False"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    Background="{StaticResource BrushInput}"
                    CornerRadius="3"
                    Padding="4"
                    ClipToBounds="False">
              <lvc:CartesianChart x:Name="RxFftChart"
                                  Background="{StaticResource BrushInput}"
                                  ClipToBounds="False"
                                  AnimationsSpeed="0"
                                  TooltipPosition="Hidden"
                                  LegendPosition="Hidden"/>
            </Border>
          </Grid>

          <Grid x:Name="StreamIqPanelHost"
                Grid.Column="1"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Right"
                Width="260">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StreamIqTitle"
                       Text="I-Q"
                       Margin="4,0,0,4"
                       Foreground="{StaticResource BrushTextMuted}"/>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="StreamIqHost"
                      BorderBrush="{StaticResource BrushBorder}"
                      BorderThickness="1"
                      CornerRadius="3"
                      Background="{StaticResource BrushInput}"
                      Padding="4"
                      ClipToBounds="True">
                <lvc:CartesianChart x:Name="RxIqChart"
                                    Width="240"
                                    Height="240"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource BrushInput}"
                                    AnimationsSpeed="0"
                                    TooltipPosition="Hidden"
                                    LegendPosition="Hidden"/>
              </Border>
              <StackPanel x:Name="StreamIqGroupLegend"
                          Grid.Column="1"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
