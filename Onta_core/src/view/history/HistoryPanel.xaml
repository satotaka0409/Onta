<UserControl x:Class="Onta.View.History.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <Button x:Name="ReloadButton"
                    Content="再読込"
                    Width="90"
                    Click="OnReloadClick"/>
            <Button x:Name="DeleteButton"
                    Content="履歴を削除"
                    Width="110"
                    Margin="8,0,0,0"
                    Click="OnDeleteClick"/>
            <TextBlock x:Name="StatusText"
                       Margin="12,5,0,0"
                       Foreground="{StaticResource BrushTextMuted}"/>
        </StackPanel>

        <TabControl Grid.Row="1"
                    x:Name="HistoryTabs"
                    SelectedIndex="0"
                    SelectionChanged="OnSelectionChanged">
            <TabItem x:Name="ReceiveHistoryTab"
                     Header="受信履歴">
                <DataGrid x:Name="ReceiveHistoryGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowDetailsVisibilityMode="Collapsed"
                          SelectionChanged="OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="受信日時"
                                                Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TimestampText}"
                                               Cursor="Hand"
                                               TextDecorations="Underline"
                                               VerticalAlignment="Center"
                                               ToolTip="クリックでブロック明細を開閉"
                                               PreviewMouseLeftButtonDown="OnReceiveTimestampClick"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ファイル名"
                                            Binding="{Binding FileName}"
                                            Width="3*"/>
                        <DataGridTextColumn Header="ファイルサイズ"
                                            Binding="{Binding FileSizeText}"
                                            Width="80"/>
                        <DataGridTextColumn Header="結果"
                                            Binding="{Binding ResultText}"
                                            Width="70"/>
                        <DataGridTextColumn Header="ブロック数"
                                            Binding="{Binding BlockCountText}"
                                            Width="65"/>
                        <DataGridTextColumn Header="音声/WAV"
                                            Binding="{Binding InputDeviceText}"
                                            Width="70"/>
                        <DataGridTextColumn Header="WAVファイル名"
                                            Binding="{Binding SourceWavFileName}"
                                            Width="4*"/>
                        <DataGridTemplateColumn Header="ダウンロード"
                                                Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="ダウンロード"
                                            Padding="8,2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Click="OnRowDownloadClick"
                                            Tag="{Binding Entry}">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanDownload}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="作成タイムスタンプ"
                                            Binding="{Binding CreatedAtText}"
                                            Width="130"/>
                        <DataGridTextColumn Header="更新タイムスタンプ"
                                            Binding="{Binding UpdatedAtText}"
                                            Width="130"/>
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Margin="8,0,8,8"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    Padding="6">
                                <DataGrid AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding BlockRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="BLK"
                                                            Binding="{Binding BlockIndexText}"
                                                            Width="50"/>
                                        <DataGridTextColumn Header="結果"
                                                            Binding="{Binding ResultText}"
                                                            Width="50"/>
                                        <DataGridTextColumn Header="サブキャリア数"
                                                            Binding="{Binding SubcarrierText}"
                                                            Width="90"/>
                                        <DataGridTextColumn Header="変調"
                                                            Binding="{Binding ModulationText}"
                                                            Width="60"/>
                                        <DataGridTextColumn Header="Stereo/mono"
                                                            Binding="{Binding ChannelText}"
                                                            Width="90"/>
                                        <DataGridTextColumn Header="ブロックサイズ"
                                                            Binding="{Binding BlockSizeText}"
                                                            Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </TabItem>

            <TabItem x:Name="SendHistoryTab"
                     Header="送信履歴">
                <DataGrid x:Name="SendHistoryGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="送信日時"
                                            Binding="{Binding TimestampText}"
                                            Width="130"/>
                        <DataGridTextColumn Header="ファイル名"
                                            Binding="{Binding FileName}"
                                            Width="3*"/>
                        <DataGridTextColumn Header="ファイルサイズ"
                                            Binding="{Binding FileSizeText}"
                                            Width="80"/>
                        <DataGridTextColumn Header="音声/WAV"
                                            Binding="{Binding OutputDeviceText}"
                                            Width="70"/>
                        <DataGridTextColumn Header="WAVファイル名"
                                            Binding="{Binding OutputWavFileName}"
                                            Width="4*"/>
                        <DataGridTextColumn Header="サブキャリア数"
                                            Binding="{Binding SubcarrierText}"
                                            Width="80"/>
                        <DataGridTextColumn Header="変調"
                                            Binding="{Binding ModulationText}"
                                            Width="60"/>
                        <DataGridTextColumn Header="Stereo/mono"
                                            Binding="{Binding ChannelText}"
                                            Width="90"/>
                        <DataGridTextColumn Header="作成タイムスタンプ"
                                            Binding="{Binding CreatedAtText}"
                                            Width="130"/>
                        <DataGridTextColumn Header="更新タイムスタンプ"
                                            Binding="{Binding UpdatedAtText}"
                                            Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem x:Name="UncompleteBlockTab"
                     Header="不明ブロック">
                <DataGrid x:Name="UncompleteBlockGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="受信日時"
                                            Binding="{Binding TimestampText}"
                                            Width="170"/>
                        <DataGridTextColumn Header="結果"
                                            Binding="{Binding ResultText}"
                                            Width="110"/>
                        <DataGridTextColumn Header="音声/WAV入力"
                                            Binding="{Binding InputDeviceText}"
                                            Width="110"/>
                        <DataGridTextColumn Header="サブキャリア数"
                                            Binding="{Binding SubcarrierText}"
                                            Width="110"/>
                        <DataGridTextColumn Header="変調"
                                            Binding="{Binding ModulationText}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Stereo/mono"
                                            Binding="{Binding ChannelText}"
                                            Width="110"/>
                        <DataGridTextColumn Header="ブロック位置"
                                            Binding="{Binding BlockPositionText}"
                                            Width="90"/>
                        <DataGridTextColumn Header="ファイルハッシュ値"
                                            Binding="{Binding FileHashText}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="ブロックハッシュ値"
                                            Binding="{Binding BlockHashText}"
                                            Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
