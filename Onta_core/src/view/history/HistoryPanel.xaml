<UserControl x:Class="Onta.View.History.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                        <Button x:Name="ReloadButton"
                                Content="再読込"
                                Width="90"
                                Click="OnReloadClick"/>
                        <Button x:Name="ExportButton"
                                Content="Payloadを保存"
                                Width="130"
                                Margin="8,0,0,0"
                                Click="OnExportClick"/>
                        <Button x:Name="DeleteButton"
                                Content="履歴を削除"
                                Width="110"
                                Margin="8,0,0,0"
                                Click="OnDeleteClick"/>
                        <TextBlock x:Name="StatusText"
                                   Margin="12,5,0,0"
                                   Foreground="{StaticResource BrushTextMuted}"/>
                </StackPanel>

                <TabControl Grid.Row="1"
                            x:Name="HistoryTabs"
                            SelectedIndex="0"
                            SelectionChanged="OnSelectionChanged">
                        <TabItem x:Name="ReceiveHistoryTab"
                                 Header="受信履歴">
                                <DataGrid x:Name="ReceiveHistoryGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          SelectionChanged="OnSelectionChanged">
                                        <DataGrid.Columns>
                                                <DataGridTextColumn Header="日時(UTC)"
                                                                    Binding="{Binding TimestampText}"
                                                                    Width="170"/>
                                                <DataGridTextColumn Header="入力"
                                                                    Binding="{Binding InputDeviceText}"
                                                                    Width="90"/>
                                                <DataGridTextColumn Header="ファイル"
                                                                    Binding="{Binding FileName}"
                                                                    Width="2*"/>
                                                <DataGridTextColumn Header="サイズ"
                                                                    Binding="{Binding FileSizeText}"
                                                                    Width="120"/>
                                                <DataGridTextColumn Header="状態"
                                                                    Binding="{Binding StatusText}"
                                                                    Width="120"/>
                                                <DataGridTextColumn Header="Payload"
                                                                    Binding="{Binding PayloadBytesText}"
                                                                    Width="120"/>
                                                <DataGridTextColumn Header="EntryId"
                                                                    Binding="{Binding EntryId}"
                                                                    Width="2*"/>
                                        </DataGrid.Columns>
                                </DataGrid>
                        </TabItem>

                        <TabItem x:Name="SendHistoryTab"
                                 Header="送信履歴">
                                <DataGrid x:Name="SendHistoryGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          SelectionChanged="OnSelectionChanged">
                                        <DataGrid.Columns>
                                                <DataGridTextColumn Header="日時(UTC)"
                                                                    Binding="{Binding TimestampText}"
                                                                    Width="170"/>
                                                <DataGridTextColumn Header="入力"
                                                                    Binding="{Binding InputDeviceText}"
                                                                    Width="90"/>
                                                <DataGridTextColumn Header="ファイル"
                                                                    Binding="{Binding FileName}"
                                                                    Width="2*"/>
                                                <DataGridTextColumn Header="サイズ"
                                                                    Binding="{Binding FileSizeText}"
                                                                    Width="120"/>
                                                <DataGridTextColumn Header="状態"
                                                                    Binding="{Binding StatusText}"
                                                                    Width="120"/>
                                                <DataGridTextColumn Header="EntryId"
                                                                    Binding="{Binding EntryId}"
                                                                    Width="2*"/>
                                        </DataGrid.Columns>
                                </DataGrid>
                        </TabItem>

                        <TabItem x:Name="UncompleteBlockTab"
                                 Header="未完了ブロック">
                                <DataGrid x:Name="UncompleteBlockGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          SelectionChanged="OnSelectionChanged">
                                        <DataGrid.Columns>
                                                <DataGridTextColumn Header="日時(UTC)"
                                                                    Binding="{Binding TimestampText}"
                                                                    Width="170"/>
                                                <DataGridTextColumn Header="種別"
                                                                    Binding="{Binding KindText}"
                                                                    Width="80"/>
                                                <DataGridTextColumn Header="ファイル"
                                                                    Binding="{Binding FileName}"
                                                                    Width="2*"/>
                                                <DataGridTextColumn Header="対象"
                                                                    Binding="{Binding TargetText}"
                                                                    Width="120"/>
                                                <DataGridTextColumn Header="DataModulation"
                                                                    Binding="{Binding DataModulationText}"
                                                                    Width="170"/>
                                                <DataGridTextColumn Header="状態"
                                                                    Binding="{Binding StateText}"
                                                                    Width="140"/>
                                                <DataGridTextColumn Header="詳細"
                                                                    Binding="{Binding DetailText}"
                                                                    Width="2*"/>
                                                <DataGridTextColumn Header="EntryId"
                                                                    Binding="{Binding EntryId}"
                                                                    Width="2*"/>
                                        </DataGrid.Columns>
                                </DataGrid>
                        </TabItem>
                </TabControl>
        </Grid>
</UserControl>
