<UserControl x:Class="Onta.View.FileEstimatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock Text="ファイル見積" FontSize="14" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,8"/>
    <DataGrid x:Name="EstimateGrid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserResizeRows="False"
              IsReadOnly="True"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              SelectionMode="Single"
              SelectionUnit="FullRow">
      <DataGrid.Columns>
        <DataGridTextColumn Header="内容" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="秒数" Binding="{Binding Seconds}" Width="*"/>
        <DataGridTextColumn Header="メーター" Binding="{Binding Meter}" Width="3*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
