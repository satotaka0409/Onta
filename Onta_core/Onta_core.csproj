<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- LiveCharts2 / SkiaSharp 3 向けに Windows 10 SDK を明示 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Onta.Core</RootNamespace>
    <AssemblyName>Onta</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>音多 (Onta)</Product>
    <AssemblyTitle>音多</AssemblyTitle>
    <Company>Onta Project</Company>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ClickOnce 配布: x64 / ARM64 の両方を publish.ps1 で発行 -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- ClickOnce / 実行時に同梱するマニュアルとスプラッシュ -->
  <ItemGroup>
    <Content Include="..\Onta_manual\*.md"
             Link="manual\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Onta_manual\onta_splash_512x256.png"
             Link="manual\onta_splash_512x256.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <Compile Remove="test_host\**" />
    <Compile Remove="bench\**" />
    <None Include="test\**" Exclude="test\bin\**;test\obj\**" />
    <None Include="test_host\**" Exclude="test_host\bin\**;test_host\obj\**" />
    <None Include="bench\**" Exclude="bench\bin\**;bench\obj\**" />
    <Page Remove="test\**" />
    <Page Remove="test_host\**" />
    <Page Remove="bench\**" />
  </ItemGroup>
</Project>
