<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- LiveCharts2 / SkiaSharp 3 向けに Windows 10 SDK を明示 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Onta.Core</RootNamespace>
    <AssemblyName>Onta</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>音多 (Onta)</Product>
    <AssemblyTitle>音多</AssemblyTitle>
    <Company>Onta Project</Company>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ClickOnce 配布: x64 / ARM64 の両方を publish.ps1 で発行 -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Onta_core.Tests" />
  </ItemGroup>

  <!-- ClickOnce / 実行時に同梱するマニュアルとスプラッシュ -->
  <ItemGroup>
    <Content Include="..\LICENSE"
             Link="LICENSE"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Onta_manual\*.md"
             Link="manual\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Onta_manual\onta_splash_512x256.png"
             Link="manual\onta_splash_512x256.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\.cursor\rules\data_struct.mdc"
             Link="manual\specification\data_struct.mdc"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\.cursor\rules\modulation.mdc"
             Link="manual\specification\modulation.mdc"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\.cursor\rules\stream.mdc"
             Link="manual\specification\stream.mdc"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\.cursor\rules\history_info.mdc"
             Link="manual\specification\history_info.mdc"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <Compile Remove="test_host\**" />
    <Compile Remove="bench\**" />
    <None Include="test\**" Exclude="test\bin\**;test\obj\**" />
    <None Include="test_host\**" Exclude="test_host\bin\**;test_host\obj\**" />
    <None Include="bench\**" Exclude="bench\bin\**;bench\obj\**" />
    <Page Remove="test\**" />
    <Page Remove="test_host\**" />
    <Page Remove="bench\**" />
  </ItemGroup>

  <!-- 通常ビルドと ClickOnce 発行の前に、仕様 mdc をマニュアルへコピーする -->
  <ItemGroup>
    <SpecificationDoc Include="$(MSBuildProjectDirectory)\..\.cursor\rules\data_struct.mdc" />
    <SpecificationDoc Include="$(MSBuildProjectDirectory)\..\.cursor\rules\modulation.mdc" />
    <SpecificationDoc Include="$(MSBuildProjectDirectory)\..\.cursor\rules\stream.mdc" />
    <SpecificationDoc Include="$(MSBuildProjectDirectory)\..\.cursor\rules\history_info.mdc" />
  </ItemGroup>

  <Target Name="CopySpecificationDocs"
          BeforeTargets="BeforeBuild;PrepareForPublish"
          Inputs="@(SpecificationDoc)"
          Outputs="@(SpecificationDoc->'$(MSBuildProjectDirectory)\..\Onta_manual\specification\%(Filename)%(Extension)')">
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\Onta_manual\specification" />
    <Copy SourceFiles="@(SpecificationDoc)"
          DestinationFiles="@(SpecificationDoc->'$(MSBuildProjectDirectory)\..\Onta_manual\specification\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high"
             Text="仕様ファイルを Onta_manual\specification へコピーしました。" />
  </Target>

  <!-- native libopus（あれば出力へコピー。無くてもビルド可） -->
  <ItemGroup>
    <None Include="native\opus\win-x64\opus.dll"
          Condition="Exists('native\opus\win-x64\opus.dll')">
      <Link>opus.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <DestinationSubDirectory Condition="'$(RuntimeIdentifier)' == 'win-arm64'"></DestinationSubDirectory>
    </None>
    <None Include="native\opus\win-arm64\opus.dll"
          Condition="Exists('native\opus\win-arm64\opus.dll') And '$(RuntimeIdentifier)' == 'win-arm64'">
      <Link>opus.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- 通常ビルド（RID なし）は x64 opus を優先 -->
  <Target Name="CopyOpusDll" AfterTargets="Build">
    <PropertyGroup>
      <_OpusSrc Condition="'$(RuntimeIdentifier)' == 'win-arm64'">$(MSBuildProjectDirectory)\native\opus\win-arm64\opus.dll</_OpusSrc>
      <_OpusSrc Condition="'$(_OpusSrc)' == ''">$(MSBuildProjectDirectory)\native\opus\win-x64\opus.dll</_OpusSrc>
    </PropertyGroup>
    <Copy SourceFiles="$(_OpusSrc)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_OpusSrc)')" />
  </Target>
</Project>
