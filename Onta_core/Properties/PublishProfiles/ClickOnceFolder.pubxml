<?xml version="1.0" encoding="utf-8"?>
<!--
  ClickOnce 配布プロファイル（音多 Onta）
  RID は publish.ps1 が win-x64 / win-arm64 を渡す（既定は win-x64）。
  PublishDir = ビルド中間出力、ClickOncePublishDir = 配布成果物。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishDir>..\..\Installer\obj\app\</PublishDir>
    <PublishUrl>..\..\Installer\publish\</PublishUrl>
    <ClickOncePublishDir>..\..\Installer\publish\</ClickOncePublishDir>
    <InstallUrl></InstallUrl>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationVersion>1.0.0.*</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>
    <IsRevisionIncremented>false</IsRevisionIncremented>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <GenerateManifests>true</GenerateManifests>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <OpenBrowserOnPublish>false</OpenBrowserOnPublish>
    <SignManifests>false</SignManifests>
    <ProductName>音多 (Onta)</ProductName>
    <PublisherName>Onta Project</PublisherName>
    <SuiteName></SuiteName>
    <ErrorReportUrl></ErrorReportUrl>
    <SupportUrl></SupportUrl>
    <History>True</History>
  </PropertyGroup>
</Project>
